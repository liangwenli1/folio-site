---
// Page not found, in each language: back home or to the help center, or on to a page people often look for. nginx
// shows it for addresses that lead nowhere: the Chinese one under /zh/, the English one anywhere else (deploy/nginx.conf).
import Base from '../../layouts/Base.astro';
import { langPaths, link, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const N = t(lang).notFound;
const LINKS = ['features/', 'download/', 'contact/'];
---
<Base lang={lang} path="" title={N.title} noindex>
  <section class="wrap nf">
    <p class="nf-code" aria-hidden="true">404</p>
    <h1>{N.title}</h1>
    <p class="lead">{N.lead}</p>
    <div class="nf-acts"><a class="btn btn-primary btn-lg" href={link(lang)}>{N.home}</a><a class="btn btn-secondary btn-lg" href={link(lang, 'help/')}>{N.help}</a></div>
    <nav class="nf-links" aria-label={N.more}>{N.links.map((label, i) => <a href={link(lang, LINKS[i])}>{label}</a>)}</nav>
  </section>
</Base>
<style>
  .nf{display:grid;justify-items:center;padding-block:80px 104px;text-align:center}
  .nf-code{font:800 clamp(7rem,18vw,12.5rem)/1 var(--f-display);letter-spacing:-.02em;color:transparent;-webkit-text-stroke:2px color-mix(in srgb,var(--accent) 35%,transparent)}
  .nf h1{margin-top:12px;font-size:clamp(2rem,4vw,2.75rem)}
  .nf .lead{margin-top:14px;font-size:16px}
  .nf-acts{display:flex;flex-wrap:wrap;justify-content:center;gap:14px;margin-top:36px}
  .nf-acts .btn{min-width:180px}
  .nf-links{display:flex;flex-wrap:wrap;justify-content:center;gap:10px 0;margin-top:48px;font-size:14.5px}
  .nf-links a{padding:0 22px;color:var(--ink-2);text-decoration:none}
  .nf-links a + a{border-left:1px solid var(--line-2)}
  .nf-links a:hover{color:var(--accent-ink)}
</style>
