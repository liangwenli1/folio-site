---
// Page not found, in each language (v2 16): 404 and what it means, then back home or to the help center. nginx shows
// it for addresses that lead nowhere: the Chinese one under /zh/, the English one anywhere else (deploy/nginx.conf).
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { langPaths, link, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const N = t(lang).notFound;
---
<Base lang={lang} path="" title={N.title} noindex>
  <section class="wrap nf">
    <p class="nf-code" aria-hidden="true">404</p>
    <h1>{N.title}</h1>
    <Icon name="search" size={48} />
    <p class="nf-msg">{N.lead}</p>
    <div class="cta-row"><a class="btn btn-primary btn-lg" href={link(lang)}>{N.home}</a><a class="btn btn-secondary btn-lg" href={link(lang, 'help/')}>{N.help}</a></div>
  </section>
</Base>
<style>
  /* v2: 404 at 72, what it means 20/32 under it; the search icon, the explanation, and the ways out */
  .nf{display:grid;justify-items:start;padding-block:68px 120px}
  .nf-code{font-size:72px;font-weight:600;line-height:80px}
  .nf h1{margin-top:22px;font-size:20px;font-weight:400;line-height:32px;color:var(--ink-3)}
  .nf > :global(.i){margin-top:28px;color:var(--ink-3)}
  .nf-msg{margin-top:28px;font-size:20px;line-height:32px;color:var(--ink-3)}
  .nf .cta-row{margin-top:48px}
  .nf .btn{min-width:180px}
</style>
