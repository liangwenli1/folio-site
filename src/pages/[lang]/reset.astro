---
import Base from '../../layouts/Base.astro';
import { langPaths, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang);
---
<Base lang={lang} path="reset/" title={d.auth.resetTitle} noindex>
  <section class="wrap page">
    <div class="page-narrow">
      <div class="page-head"><h1>{d.auth.resetTitle}</h1></div>
      <form class="panel form" id="form" novalidate>
        <div class="notice dev" id="dev" hidden>{d.auth.devNotice}</div>
        <div class="notice error" id="err" role="alert" hidden></div>
        <div class="field"><label for="email">{d.auth.email}</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field"><label for="code">{d.auth.code}</label><input class="code-input" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required /></div>
        <div class="field">
          <label for="password">{d.auth.newPassword}</label>
          <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required />
          <span class="hint">{d.auth.passwordHint}</span>
        </div>
        <button class="btn btn-stamp full" type="submit">{d.auth.reset}</button>
      </form>
    </div>
  </section>
</Base>
<script>
  import { api } from '../../lib/api';
  import { $, d, devBuild, onSubmit, param, to } from '../../scripts/session';
  $('dev').hidden = !devBuild;
  $<HTMLInputElement>('email').value = param('email') ?? '';
  onSubmit($<HTMLFormElement>('form'), $('err'), async () => {
    const email = $<HTMLInputElement>('email').value.trim(), password = $<HTMLInputElement>('password').value;
    if (password.length < 8) throw d.errors.passwordShort;
    await api('POST', '/auth/password/reset', { email, code: $<HTMLInputElement>('code').value, password });
    location.assign(`${to('login/')}?reset=1&email=${encodeURIComponent(email)}`);
  });
</script>
