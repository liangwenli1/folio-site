---
// The account (option A, the user 10-29, like the workbench's Account): a menu card on the left (the login email, the
// five parts, logging out) and one part on the right, kept in the address (?tab=) so a reload or a link comes back to
// it. The plan and payments are the shown workspace's (?ws=, picked at the top of that part); workspaces are made,
// renamed and joined in their own part.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Password from '../../components/Password.astro';
import '../../styles/app.css';
import type { IconName } from '../../lib/icons';
import { INSTALLERS } from '../../lib/installers';
import { langPaths, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang);
const a = d.account;
const TABS: [keyof typeof a.tabs, IconName][] = [['plan', 'billing'], ['workspaces', 'layers'], ['info', 'user'], ['password', 'lock'], ['download', 'download']];
const SYSTEMS: [string, IconName, string | null][] = [['Windows', 'windows', INSTALLERS.windows], ['macOS', 'apple', INSTALLERS.mac]];
---
<Base lang={lang} path="account/" title={a.title} noindex>
  <section class="wrap page">
    <div class="page-head"><h1>{a.title}</h1></div>
    <div class="notice error" id="err" role="alert" hidden></div>
    <div class="ac" id="acct" hidden>
      <nav class="panel ac-nav" aria-label={a.title}>
        <div class="ac-me"><span class="ac-av" id="me-av" aria-hidden="true"></span><span><b id="me-email"></b><small id="me-verified"></small></span></div>
        {TABS.map(([key, icon]) => <a href={`?tab=${key}`} data-tab={key}><Icon name={icon} />{a.tabs[key]}</a>)}
        <hr />
        <button type="button" id="logout"><Icon name="logout" />{d.auth.logout}</button>
      </nav>

      <div class="ac-part" data-part="plan" hidden>
        <section class="panel ac-card" aria-labelledby="plan-h">
          <div class="ac-h">
            <h2 id="plan-h">{a.plan}</h2>
            <div class="field ac-ws" id="ws-pick" hidden><label for="ws-select">{a.workspace}</label><select id="ws-select"></select></div>
          </div>
          <div class="ac-plan">
            <div>
              <div class="row"><b class="ac-plan-name" id="plan-name"></b><span class="chip run" id="plan-trial" hidden><Icon name="clock" />{a.trialing}</span></div>
              <p id="plan-status"></p>
            </div>
            <div class="row" id="plan-actions">
              <a class="btn btn-secondary" id="add-profiles" href="#" hidden>{a.addProfiles}</a>
              <button class="btn btn-secondary" type="button" id="start-trial" hidden>{a.startTrial}</button>
              <button class="btn btn-secondary" type="button" id="resume" hidden>{a.resume}</button>
              <a class="btn btn-primary" id="change-plan" href="#">{a.changePlan}</a>
            </div>
          </div>
          <div class="ac-stats">
            <div><span>{a.profiles}</span><b id="plan-usage"></b><span class="meter"><i id="plan-meter"></i></span></div>
            <div><span>{a.members}</span><b id="plan-members"></b></div>
            <div><span>{a.logs}</span><b id="plan-logs"></b></div>
          </div>
          <button class="linkish fine ac-cancel" type="button" id="cancel" hidden>{a.cancelPlan}</button>
          <div class="confirm" id="cancel-confirm" hidden>
            <span>{a.cancelConfirm}</span>
            <button class="btn btn-secondary btn-sm" type="button" id="cancel-yes">{a.confirmCancel}</button>
            <button class="linkish fine" type="button" id="cancel-no">{a.cancel}</button>
          </div>
        </section>
        <section class="panel ac-card" id="pay-panel" aria-labelledby="pay-h">
          <div class="ac-h"><h2 id="pay-h">{a.payments}</h2></div>
          <p class="ac-empty" id="no-pay" hidden>{a.noPayments}</p>
          <div class="tbl-scroll">
            <table class="list" id="pay-table" hidden>
              <thead><tr>{a.cols.map(col => <th scope="col">{col}</th>)}</tr></thead>
              <tbody id="pay-rows"></tbody>
            </table>
          </div>
        </section>
      </div>

      <section class="panel ac-card" data-part="workspaces" aria-labelledby="ws-h" hidden>
        <div class="ac-h"><h2 id="ws-h">{a.workspaces}</h2><button class="btn btn-secondary btn-sm" type="button" id="ws-new"><Icon name="plus" />{a.newWorkspace}</button></div>
        <form class="row ac-new" id="ws-form" hidden>
          <div class="field"><input id="ws-name" maxlength="80" aria-label={a.workspaceName} placeholder={a.workspaceName} /></div>
          <button class="btn btn-primary btn-sm" type="submit">{a.create}</button>
          <button class="btn btn-text btn-sm" type="button" id="ws-cancel">{a.cancel}</button>
        </form>
        <ul class="ac-list" id="ws-list"></ul>
        <div id="inv-panel" hidden>
          <h3 class="ac-sub">{a.invitations}</h3>
          <ul class="ac-list" id="inv-list"></ul>
        </div>
      </section>

      <section class="panel ac-card" data-part="info" aria-labelledby="info-h" hidden>
        <div class="ac-h"><h2 id="info-h">{a.tabs.info}</h2></div>
        <dl class="kv ac-kv">
          <dt>{d.auth.email}</dt><dd><span id="email"></span><span id="verified"></span></dd>
          <dt>{a.language}</dt>
          <dd><div class="seg" role="group" aria-label={a.language} id="locale">
            <button type="button" data-locale="zh" aria-pressed="false">{a.langs.zh}</button>
            <button type="button" data-locale="en" aria-pressed="false">{a.langs.en}</button>
          </div></dd>
        </dl>
      </section>

      <section class="panel ac-card" data-part="password" aria-labelledby="pw-h" hidden>
        <div class="ac-h"><h2 id="pw-h">{a.tabs.password}</h2></div>
        <form class="form ac-pw" id="pw-form" novalidate>
          <div class="notice ok" id="pw-ok" role="status" hidden>{a.pw.done}</div>
          <div class="notice error" id="pw-err" role="alert" hidden></div>
          <div class="field"><label class="req" for="pw-current">{a.pw.current}</label><Password lang={lang} id="pw-current" autocomplete="current-password" /></div>
          <div class="field">
            <label class="req" for="pw-new">{a.pw.new}</label>
            <Password lang={lang} id="pw-new" autocomplete="new-password" minlength={8} />
            <span class="hint">{d.auth.passwordHint}</span>
          </div>
          <div class="field"><label class="req" for="pw-confirm">{a.pw.confirm}</label><Password lang={lang} id="pw-confirm" autocomplete="new-password" minlength={8} /></div>
          <div><button class="btn btn-primary" type="submit">{a.pw.save}</button></div>
        </form>
      </section>

      <section class="panel ac-card ac-dl" data-part="download" aria-labelledby="dl-h" hidden>
        <div><h2 id="dl-h">{a.tabs.download}</h2><p>{a.downloadBody}</p></div>
        {SYSTEMS.map(([name, icon, href]) => (href
          ? <a class="btn btn-secondary" href={href}><Icon name={icon} />{name}</a>
          : <button class="btn btn-secondary" type="button" title={d.download.soon} disabled><Icon name={icon} />{name}</button>))}
      </section>
    </div>
  </section>
</Base>
<script>
  import { api, canManage, roleLabel, type Me, type Payment, type Workspace } from '../../lib/api';
  import { day, money } from '../../lib/format';
  import { ICONS } from '../../lib/icons';
  import { $, busy, d, esc, invalid, lang, onSubmit, param, requireMe, showError, to } from '../../scripts/session';

  const a = d.account;
  // The status labels' icons (components/Icon.astro draws the same paths at build time).
  const icon = (path: string) => `<svg class="i" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="${path}"/></svg>`;
  const CHECK = icon(ICONS.check), ALERT = icon(ICONS.alert), UNDO = icon(ICONS.back);
  // A letter on a coloured square, its colour from the name as in the workbench (ui.tsx Avatar), so a workspace looks
  // the same in both.
  const hue = (text: string) => [...text].reduce((n, c) => n + c.charCodeAt(0), 0) % 6;
  const letter = (text: string) => [...text.trim()][0]?.toUpperCase() ?? '?';
  const avatar = (text: string) => `<span class="ac-av c${hue(text)}" aria-hidden="true">${esc(letter(text))}</span>`;
  let me: Me, ws: Workspace;
  const fail = (e: unknown) => showError($('err'), e);

  // The part on show, in the address; ?ws= stays as it is.
  const TABS = ['plan', 'workspaces', 'info', 'password', 'download'];
  function show(tab: string){
    const part = TABS.includes(tab) ? tab : 'plan';
    document.querySelectorAll<HTMLElement>('[data-part]').forEach(p => { p.hidden = p.dataset.part !== part; });
    document.querySelectorAll('[data-tab]').forEach(n => { if (n.getAttribute('data-tab') === part) n.setAttribute('aria-current', 'page'); else n.removeAttribute('aria-current'); });
    const url = new URL(location.href);
    url.searchParams.set('tab', part);
    history.replaceState(null, '', url);
  }
  document.querySelectorAll<HTMLAnchorElement>('[data-tab]').forEach(n => n.addEventListener('click', ev => { ev.preventDefault(); show(n.dataset.tab!); }));
  const go = (tab: string, wsId: string) => location.assign(`?tab=${tab}&ws=${wsId}`);

  async function load(){
    me = await requireMe();
    const current = me.workspaces.find(w => w.id === param('ws')) ?? me.workspaces[0];
    ws = await api<Workspace>('GET', `/workspaces/${current.id}`);
    renderProfile(); renderWorkspaces(); renderPlan();
    await Promise.all([renderPayments(), renderInvitations()]);
    show(param('tab') ?? 'plan');
    $('acct').hidden = false;
  }

  function renderProfile(){
    const verified = me.user.emailVerified;
    $('me-av').className = `ac-av c${hue(me.user.email)}`;
    $('me-av').textContent = letter(me.user.email);
    $('me-email').textContent = $('email').textContent = me.user.email;
    $('me-verified').textContent = verified ? a.verified : a.unverified;
    $('verified').innerHTML = verified
      ? `<span class="chip ok">${CHECK}${a.verified}</span>`
      : `<span class="chip warn">${ALERT}${a.unverified}</span> <a href="${to('verify/')}?next=${encodeURIComponent(location.pathname + location.search)}">${a.verifyNow}</a>`;
    document.querySelectorAll('[data-locale]').forEach(b => b.setAttribute('aria-pressed', String(b.getAttribute('data-locale') === me.user.locale)));
  }

  function renderWorkspaces(){
    $('ws-list').innerHTML = me.workspaces.map(w => `
      <li data-id="${w.id}">
        ${avatar(w.name)}
        <span class="ac-name"><b>${esc(w.name)}</b><small>${d.plans[w.plan]} · ${roleLabel(w.role, a.roles)}</small></span>
        <a class="btn btn-secondary btn-sm" href="?tab=plan&ws=${w.id}">${a.planOf}</a>
        ${canManage(w.role) ? `<button class="btn btn-text btn-sm" type="button" data-rename="${w.id}">${a.rename}</button>` : ''}
      </li>`).join('');
    const pick = $<HTMLSelectElement>('ws-select');
    pick.innerHTML = me.workspaces.map(w => `<option value="${w.id}">${esc(w.name)}</option>`).join('');
    pick.value = ws.id;
    $('ws-pick').hidden = me.workspaces.length < 2;
  }
  $('ws-select').addEventListener('change', ev => go('plan', (ev.target as HTMLSelectElement).value));

  // Invitations sent to this address, joined or declined right here.
  async function renderInvitations(){
    const { invitations } = await api<{ invitations: { id: string; workspaceName: string; inviter: string | null; role: { key: string | null; name: string } }[] }>('GET', '/me/invitations');
    $('inv-panel').hidden = !invitations.length;
    $('inv-list').innerHTML = invitations.map(i => `
      <li data-inv="${i.id}">
        ${avatar(i.workspaceName)}
        <span class="ac-name"><b>${esc(i.workspaceName)}</b><small>${esc(a.invitedBy(i.inviter ?? 'Folio', roleLabel(i.role, a.roles)))}</small></span>
        <button class="btn btn-text btn-sm" type="button" data-decline="${i.id}">${a.decline}</button>
        <button class="btn btn-primary btn-sm" type="button" data-accept="${i.id}">${a.accept}</button>
      </li>`).join('');
  }
  $('inv-list').addEventListener('click', async ev => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('button[data-accept],button[data-decline]');
    if (!b) return;
    busy(b, true);
    try {
      if (b.dataset.accept){
        const joined = await api<{ id: string }>('POST', `/invitations/${b.dataset.accept}/accept`);
        go('workspaces', joined.id);
      } else {
        await api('POST', `/invitations/${b.dataset.decline}/decline`);
        await renderInvitations();
      }
    } catch (e){ fail(e); busy(b, false); }
  });

  function renderPlan(){
    const s = ws.subscription, manager = canManage(ws.role);
    const paid = s.status === 'active' && s.plan !== 'free';
    $('plan-name').textContent = s.addonPacks ? d.pricing.calc.withPacks(d.plans[s.plan], s.addonPacks) : d.plans[s.plan];
    $('plan-trial').hidden = s.status !== 'trialing';
    $('plan-status').textContent =
      s.status === 'trialing' ? a.trialEnds(day(s.trialEndsAt!, lang)) :
      paid && s.cancelAtPeriodEnd ? a.ends(day(s.currentPeriodEnd!, lang)) :
      paid && s.scheduledPlan ? a.scheduled(d.plans[s.scheduledPlan], day(s.currentPeriodEnd!, lang)) :
      paid ? `${a.renews(day(s.currentPeriodEnd!, lang))} · ${d.periods[s.period!]}` : '';
    const of = (used: number, limit: string | number) => `${used}<small> / ${limit}</small>`;
    $('plan-usage').innerHTML = of(ws.usage.profiles, s.entitlements.profiles);
    $<HTMLElement>('plan-meter').style.width = `${Math.min(100, (ws.usage.profiles / s.entitlements.profiles) * 100)}%`;
    $('plan-members').innerHTML = of(ws.usage.members, s.entitlements.members ?? a.unlimited);
    $('plan-logs').innerHTML = `${s.entitlements.logDays}<small> ${a.days}</small>`;
    const checkout = `${to('checkout/')}?ws=${ws.id}`;
    $<HTMLAnchorElement>('change-plan').href = checkout;
    $<HTMLAnchorElement>('add-profiles').href = checkout;
    $('plan-actions').hidden = !manager;
    $('add-profiles').hidden = !paid;
    $('start-trial').hidden = !s.trialAvailable;
    $('cancel').hidden = !paid || s.cancelAtPeriodEnd;
    $('resume').hidden = !paid || !(s.cancelAtPeriodEnd || s.scheduledPlan);
    $('cancel-confirm').hidden = true;
    $('pay-panel').hidden = !manager;
  }

  async function renderPayments(){
    if (!canManage(ws.role)) return;
    const { payments } = await api<{ payments: Payment[] }>('GET', `/workspaces/${ws.id}/payments`);
    $('no-pay').hidden = payments.length > 0;
    $('pay-table').hidden = payments.length === 0;
    $('pay-rows').innerHTML = payments.map(p => `
      <tr data-id="${p.id}">
        <td>${day(p.createdAt, lang)}</td>
        <td><a class="mono" href="${to('invoice/')}?id=${p.id}">${p.invoiceNumber}</a></td>
        <td class="mono">${money(p.amountCents, lang)}</td>
        <td>${p.status === 'paid' ? `<span class="chip ok">${CHECK}${a.paid}</span>` : `<span class="chip">${UNDO}${a.refunded}</span>`}</td>
        <td class="act">${p.refundable ? `<button class="btn btn-text btn-sm" type="button" data-refund="${p.id}">${a.refund}</button>` : ''}</td>
      </tr>`).join('');
  }

  async function refreshWorkspace(){
    ws = await api<Workspace>('GET', `/workspaces/${ws.id}`);
    me = await api<Me>('GET', '/me');
    renderWorkspaces(); renderPlan(); await renderPayments();
  }

  const act = (fn: () => Promise<unknown>) => async () => { $('err').hidden = true; try { await fn(); await refreshWorkspace(); } catch (e){ fail(e); } };
  $('start-trial').addEventListener('click', act(() => api('POST', `/workspaces/${ws.id}/billing/trial`)));
  $('resume').addEventListener('click', act(() => api('POST', `/workspaces/${ws.id}/billing/resume`)));
  $('cancel').addEventListener('click', () => { $('cancel-confirm').hidden = false; });
  $('cancel-no').addEventListener('click', () => { $('cancel-confirm').hidden = true; });
  $('cancel-yes').addEventListener('click', act(() => api('POST', `/workspaces/${ws.id}/billing/cancel`)));

  $('pay-rows').addEventListener('click', ev => {
    const id = (ev.target as HTMLElement).closest<HTMLElement>('[data-refund]')?.dataset.refund;
    if (!id) return;
    const row = $('pay-rows').querySelector(`tr[data-id="${id}"]`)!;
    const confirmRow = document.createElement('tr');
    confirmRow.innerHTML = `<td colspan="5"><div class="confirm"><span>${a.refundConfirm}</span><button class="btn btn-secondary btn-sm" type="button" data-yes>${a.confirmRefund}</button><button class="linkish fine" type="button" data-no>${a.cancel}</button></div></td>`;
    row.after(confirmRow);
    confirmRow.querySelector('[data-no]')!.addEventListener('click', () => confirmRow.remove());
    confirmRow.querySelector('[data-yes]')!.addEventListener('click', act(() => api('POST', `/payments/${id}/refund`)));
  });

  $('ws-list').addEventListener('click', ev => {
    const id = (ev.target as HTMLElement).closest<HTMLElement>('[data-rename]')?.dataset.rename;
    if (!id) return;
    const li = $('ws-list').querySelector<HTMLElement>(`li[data-id="${id}"]`)!;
    const w = me.workspaces.find(x => x.id === id)!;
    li.innerHTML = `${avatar(w.name)}<form class="row ac-new"><div class="field"><input maxlength="80" value="${esc(w.name)}" aria-label="${a.rename}" /></div><button class="btn btn-primary btn-sm" type="submit">${a.save}</button><button class="btn btn-text btn-sm" type="button" data-no>${a.cancel}</button></form>`;
    const form = li.querySelector('form')!;
    form.querySelector('input')!.focus();
    form.querySelector('[data-no]')!.addEventListener('click', renderWorkspaces);
    form.addEventListener('submit', async e => {
      e.preventDefault();
      try { await api('PATCH', `/workspaces/${id}`, { name: form.querySelector('input')!.value }); await refreshWorkspace(); } catch (err){ fail(err); }
    });
  });

  // A new workspace: the button opens the name's row; made, it is shown, on the Free plan.
  const wsForm = $<HTMLFormElement>('ws-form');
  const toggleNew = (open: boolean) => { wsForm.hidden = !open; $('ws-new').hidden = open; if (open) $('ws-name').focus(); };
  $('ws-new').addEventListener('click', () => toggleNew(true));
  $('ws-cancel').addEventListener('click', () => { wsForm.reset(); toggleNew(false); });
  wsForm.addEventListener('submit', async ev => {
    ev.preventDefault();
    const name = $<HTMLInputElement>('ws-name').value.trim();
    if (!name) return;
    try {
      const w = await api<{ id: string }>('POST', '/workspaces', { name });
      go('workspaces', w.id);
    } catch (e){ fail(e); }
  });

  $('locale').addEventListener('click', async ev => {
    const locale = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-locale]')?.dataset.locale;
    if (!locale || locale === me.user.locale) return;
    try { await api('PATCH', '/me', { locale }); location.assign(`/${locale}/account/${location.search}`); } catch (e){ fail(e); }
  });

  // Changing the password: the current one first; done, every other sign-in of this account ends (the server's rule).
  const current = $<HTMLInputElement>('pw-current'), next = $<HTMLInputElement>('pw-new'), again = $<HTMLInputElement>('pw-confirm');
  onSubmit($<HTMLFormElement>('pw-form'), $('pw-err'), async () => {
    $('pw-ok').hidden = true;
    if (invalid([
      [current, current.value ? '' : d.errors.passwordMissing],
      [next, next.value.length >= 8 && next.value.length <= 64 ? '' : d.errors.passwordShort],
      [again, again.value === next.value ? '' : d.errors.passwordMismatch]
    ])) return;
    await api('POST', '/auth/password/change', { current: current.value, password: next.value });
    $<HTMLFormElement>('pw-form').reset();
    $('pw-ok').hidden = false;
  });

  $('logout').addEventListener('click', async () => {
    try { await api('POST', '/auth/logout'); } finally { location.assign(`/${lang}/`); }
  });

  load().catch(fail);
</script>
