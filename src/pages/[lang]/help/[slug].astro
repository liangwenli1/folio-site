---
// A guide: numbered steps (some with a picture of that part of the workbench), a note, whether it helped (kept on the
// server; saying so can fail, and then the page says that), and the previous and next guides.
import HelpPage from '../../../layouts/HelpPage.astro';
import Icon from '../../../components/Icon.astro';
import Shot from '../../../components/Shot.astro';
import { ORDER, PICTURES, UPDATED, categoryOf, type Slug } from '../../../lib/help';
import { LANGS, link, t, type Lang } from '../../../lib/i18n';

export const getStaticPaths = () => LANGS.flatMap(lang => ORDER.map(slug => ({ params: { lang, slug } })));
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as Slug;
const d = t(lang), H = d.help, A = H.articles[slug];
const at = ORDER.indexOf(slug), prev = ORDER[at - 1], next = ORDER[at + 1];
const cat = categoryOf(d, slug);
const pictures = PICTURES[slug] ?? {};
---
<HelpPage lang={lang} path={`help/${slug}/`} title={A.title} description={A.summary}
  crumbs={[[H.home, link(lang, 'help/')], [H.categories[cat].title, link(lang, `help/#${cat}`)], [A.title, null]]}
  toc={A.sections.map((s, i): [string, string] => [`s${i + 1}`, `${i + 1}. ${s.title}`])}>
  <header class="art-head">
    <h1>{A.title}</h1>
    <p class="art-meta">{H.updated(UPDATED)}</p>
    <p class="lead">{A.lead}</p>
  </header>
  {A.sections.map((s, i) => (
    <section class="art-sec" id={`s${i + 1}`} aria-labelledby={`s${i + 1}-h`}>
      <h2 id={`s${i + 1}-h`}><span class="art-n">{i + 1}</span>{s.title}</h2>
      {s.body.map(p => <p>{p}</p>)}
      {pictures[i] && <Shot lang={lang} name={pictures[i].name} alt={s.title} zoom={pictures[i].zoom} origin={pictures[i].origin} ratio="16/9" />}
    </section>
  ))}
  <p class="art-note"><Icon name="info" /><span><b>{H.note}</b>{A.note}</span></p>
  <div class="art-foot">
    <div class="fb" data-page={slug}>
      <span>{H.feedback.ask}</span>
      <button type="button" class="btn btn-secondary btn-sm" data-helpful="true"><Icon name="thumb" />{H.feedback.yes}</button>
      <button type="button" class="btn btn-secondary btn-sm fb-no" data-helpful="false"><Icon name="thumb" />{H.feedback.no}</button>
      <p class="fb-msg" role="status" data-thanks={H.feedback.thanks} data-failed={H.feedback.failed}></p>
    </div>
    <nav class="art-pn" aria-label={`${H.prev} / ${H.next}`}>
      {prev ? <a href={link(lang, `help/${prev}/`)}><small><Icon name="back" />{H.prev}</small><b>{H.articles[prev].title}</b></a> : <span></span>}
      {next && <a class="art-next" href={link(lang, `help/${next}/`)}><small>{H.next}<Icon name="chevr" /></small><b>{H.articles[next].title}</b></a>}
    </nav>
  </div>
</HelpPage>
<script>
  import { api } from '../../../lib/api';
  import { pageLang } from '../../../lib/i18n';
  import { busy } from '../../../scripts/session';
  // Whether it helped: kept on the server; the answer stays once it is in, and a failure says so and lets them try again.
  const box = document.querySelector<HTMLElement>('.fb')!;
  const msg = box.querySelector<HTMLElement>('.fb-msg')!;
  box.querySelectorAll<HTMLButtonElement>('button').forEach(b => b.addEventListener('click', async () => {
    box.querySelectorAll('button').forEach(x => { x.disabled = true; });
    busy(b, true);
    try {
      await api('POST', '/doc-feedback', { page: box.dataset.page, helpful: b.dataset.helpful === 'true', locale: pageLang() });
      b.removeAttribute('aria-busy');
      b.setAttribute('aria-pressed', 'true');
      msg.textContent = msg.dataset.thanks!;
      msg.className = 'fb-msg ok';
    } catch {
      box.querySelectorAll('button').forEach(x => { busy(x, false); });
      msg.textContent = msg.dataset.failed!;
      msg.className = 'fb-msg bad';
    }
  }));
</script>
<style>
  .art-head{display:grid;gap:10px;margin-bottom:12px}
  .art-meta{font-size:12px;color:var(--ink-3)}
  .art-sec{display:grid;gap:12px;padding-top:28px}
  .art-sec h2{display:flex;align-items:center;gap:12px;font-size:20px;line-height:1.35}
  .art-n{display:grid;place-items:center;width:30px;height:30px;flex:none;border-radius:50%;background:var(--accent);color:var(--on-accent);font:600 14px var(--f-data)}
  .art-sec p{padding-left:42px;color:var(--ink-2);line-height:1.8}
  .art-sec :global(.shot){margin:6px 0 0 42px;box-shadow:none}
  .art-note{display:flex;gap:10px;margin-top:32px;padding:14px 16px;border-radius:var(--r-card);background:var(--warn-soft);border:1px solid color-mix(in srgb,var(--warn) 30%,transparent);font-size:14px;line-height:1.7;color:var(--ink)}
  .art-note :global(.i){margin-top:3px;color:var(--warn-ink)}
  .art-note b{margin-right:8px}
  .art-foot{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px 24px;margin-top:32px;padding:18px 20px;border:1px solid var(--line);border-radius:var(--r-card);background:var(--card)}
  .fb{display:flex;flex-wrap:wrap;align-items:center;gap:10px;font-size:14px;font-weight:600}
  .fb > span{white-space:nowrap}
  .fb .btn[aria-pressed="true"]{border-color:var(--accent);color:var(--accent-ink);background:var(--accent-soft)}
  .fb-no :global(.i){rotate:180deg}
  .fb-msg{flex-basis:100%;font-size:14px;font-weight:400}
  .fb-msg:empty{display:none}
  .fb-msg.ok{color:var(--good-ink)}
  .fb-msg.bad{color:var(--bad-ink)}
  .art-pn{display:flex;gap:24px}
  .art-pn a{display:grid;gap:2px;text-decoration:none}
  .art-pn small{display:inline-flex;align-items:center;gap:4px;font-size:12px;color:var(--ink-3)}
  .art-pn b{font-size:14px;font-weight:600}
  .art-pn a:hover b{color:var(--accent-ink)}
  .art-next{text-align:right;justify-items:end}
  @media (max-width:860px){.art-sec p,.art-sec :global(.shot){margin-left:0;padding-left:0}}
</style>
