---
// The help center (v2): a search over the guides, then every guide by what it is about, the API reference for
// developers, and questions. A search goes in the address (?q=), so going back or reloading keeps it; the page then
// shows what it found instead (v2 17), or that nothing matched with other words to try and a way to ask (v2 28). The
// search runs in the browser.
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import Faq from '../../../components/Faq.astro';
import { CATEGORIES, ORDER, categoryOf } from '../../../lib/help';
import { langPaths, link, t, type Lang } from '../../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang), H = d.help, R = H.results;
const icon = (slug: (typeof ORDER)[number]) => CATEGORIES.find(c => c.id === categoryOf(d, slug))!.icon;
const index = ORDER.map(s => {
  const a = H.articles[s];
  return { href: link(lang, `help/${s}/`), title: a.title, summary: a.summary, cat: H.categories[categoryOf(d, s)].title, text: [a.lead, ...a.sections.flatMap(x => [x.title, ...x.body])].join(' ') };
});
const here = link(lang, 'help/');
---
<Base lang={lang} path="help/" title={H.title} description={H.lead}>
  <script is:inline>if (new URLSearchParams(location.search).get('q')?.trim()) document.documentElement.classList.add('hq');</script>
  <section class="phero">
    <div class="wrap">
      <h1 class="hero-title" data-title data-found={R.title} data-empty={R.none}>{H.title}</h1>
      <p class="lead" data-lead={R.keyword}>{H.lead}</p>
      <form class="form hsearch" role="search" action={here} method="get">
        <div class="field">
          <label for="q" data-label={R.label}>{H.searchLabel}</label>
          <div class="hsearch-row">
            <input id="q" type="search" name="q" placeholder={H.search} autocomplete="off" />
            <button class="btn btn-primary" type="submit" data-again={R.again}>{H.searchBtn}</button>
          </div>
        </div>
      </form>
      <p class="hexamples">{H.examplesLabel}{H.examples.map(e => <a href={`${here}?q=${encodeURIComponent(e)}`}>{e}</a>)}</p>
    </div>
  </section>

  <section class="msec" data-search aria-live="polite">
    <div class="wrap">
      <p class="hcount" data-count data-one={R.one} data-many={R.many}></p>
      <ul class="hlist" data-results data-read={H.read}></ul>
      <div class="hnone" data-none hidden>
        <Icon name="search" size={48} />
        <p>{R.noneText}</p>
        <div class="cta-row">
          <button class="btn btn-primary btn-lg" type="button" data-retry>{R.again}</button>
          <a class="btn btn-secondary btn-lg" href={link(lang, 'contact/')}>{H.contact}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="msec" data-normal>
    <div class="wrap">
      <div class="msec-head"><h2>{H.guides.title}</h2><p>{H.guides.lead}</p></div>
      <div class="cols grid-3">
        {ORDER.map(s => (
          <article class="fcard"><Icon name={icon(s)} size={24} /><h3>{H.articles[s].title}</h3><p>{H.articles[s].summary}</p><a class="more" href={link(lang, `help/${s}/`)}>{H.read}</a></article>
        ))}
        <article class="fcard"><Icon name="code" size={24} /><h3>{H.apiLink}</h3><p>{H.apiSummary}</p><a class="more" href={link(lang, 'help/api/')}>{H.read}</a></article>
      </div>
    </div>
  </section>

  <section class="msec" data-normal>
    <div class="wrap">
      <Faq title={H.faq.title} items={H.faq.items} />
      <p class="notice hask">{H.ask}<a href={link(lang, 'contact/')}>{H.contact}</a></p>
    </div>
  </section>
</Base>
<script type="application/json" id="help-index" set:html={JSON.stringify(index)}></script>
<script>
  // A search (?q=): the guides with every word somewhere in them, those with it in the title first, then the
  // category, the summary, the text. The first screen says what was searched for.
  type Item = { href: string; title: string; summary: string; cat: string; text: string };
  const q = new URLSearchParams(location.search).get('q')?.trim() ?? '';
  const input = document.querySelector<HTMLInputElement>('#q')!;
  if (q){
    const items = JSON.parse(document.getElementById('help-index')!.textContent!) as Item[];
    const words = q.toLowerCase().split(/\s+/);
    const has = (text: string, w: string) => text.toLowerCase().includes(w);
    const score = (i: Item) => words.reduce((n, w) => n + (has(i.title, w) ? 8 : 0) + (has(i.cat, w) ? 4 : 0) + (has(i.summary, w) ? 2 : 0) + (has(i.text, w) ? 1 : 0), 0);
    const found = items.filter(i => words.every(w => has(`${i.title} ${i.cat} ${i.summary} ${i.text}`, w)))
      .map(i => ({ i, n: score(i) })).sort((a, b) => b.n - a.n).map(x => x.i);
    const title = document.querySelector<HTMLElement>('[data-title]')!;
    const lead = document.querySelector<HTMLElement>('[data-lead]')!;
    const list = document.querySelector<HTMLElement>('[data-results]')!;
    title.textContent = found.length ? title.dataset.found! : title.dataset.empty!;
    lead.textContent = lead.dataset.lead!.replace('{q}', q);
    document.title = `${title.textContent} · Folio`;
    input.value = q;
    const label = document.querySelector<HTMLElement>('label[for="q"]')!;
    label.textContent = label.dataset.label!;
    const go = document.querySelector<HTMLButtonElement>('.hsearch [type="submit"]')!;
    go.textContent = go.dataset.again!;
    const count = document.querySelector<HTMLElement>('[data-count]')!;
    count.textContent = found.length ? (found.length === 1 ? count.dataset.one! : count.dataset.many!).replace('{n}', String(found.length)) : '';
    count.hidden = !found.length;
    list.replaceChildren(...found.map(i => {
      const li = document.createElement('li');
      li.className = 'card';
      li.innerHTML = '<div><small></small><h2></h2><p></p></div><a class="btn btn-secondary"></a>';
      li.querySelector('small')!.textContent = i.cat;
      li.querySelector('h2')!.textContent = i.title;
      li.querySelector('p')!.textContent = i.summary;
      const a = li.querySelector('a')!;
      a.href = i.href;
      a.textContent = list.dataset.read!;
      return li;
    }));
    document.querySelector<HTMLElement>('[data-none]')!.hidden = found.length > 0;
  }
  document.querySelector('[data-retry]')?.addEventListener('click', () => { input.focus(); input.select(); });
</script>
<style>
  /* the search (v2): the label above, the box 760 wide and the button beside it */
  .hsearch{margin-top:28px}
  .hsearch-row{display:flex;gap:20px;max-width:900px}
  .hsearch-row input{flex:1;min-width:0;max-width:760px}
  .hsearch-row .btn{min-width:120px}
  .hexamples{display:flex;flex-wrap:wrap;gap:6px 16px;margin-top:14px;font-size:14px;color:var(--ink-3)}
  .hexamples a{color:var(--ink-2);text-decoration:none}
  .hexamples a:hover{color:var(--action);text-decoration:underline;text-underline-offset:3px}
  /* a search shows what it found instead of the guides; the inline script marks the page before it is drawn */
  :global(html.hq) [data-normal],:global(html:not(.hq)) [data-search]{display:none}
  .hcount{margin-bottom:24px;font-size:16px;color:var(--ink-3)}
  .hlist{display:grid;gap:24px;margin:0;padding:0;list-style:none}
  .hlist :global(li){display:flex;align-items:center;gap:24px;padding:22px 32px 22px 24px}
  .hlist :global(li > div){flex:1;min-width:0;display:grid;gap:4px}
  .hlist :global(small){font-size:12px;color:var(--ink-3)}
  .hlist :global(h2){font-size:20px;line-height:28px}
  .hlist :global(p){font-size:16px;line-height:28px;color:var(--ink-3)}
  .hlist :global(.btn){min-width:132px}
  .hnone{display:grid;justify-items:start}
  .hnone > :global(.i){color:var(--ink-3)}
  .hnone > p{margin-top:28px;font-size:20px;line-height:32px;color:var(--ink-3)}
  .hnone .cta-row{margin-top:48px}
  .hask{margin-top:24px}
  .hask a{color:var(--action)}
  @media (max-width:640px){.hsearch-row{flex-direction:column;gap:12px}.hlist :global(li){flex-direction:column;align-items:stretch;padding:20px}}
</style>
