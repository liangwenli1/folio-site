---
// What changed, release by release: each says which part of Folio it is (the workbench or the website) and what was
// added, improved and fixed; tabs show one part at a time. Subscribing is not open yet, and the box says so.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../lib/icons';
import { langPaths, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const L = t(lang).changelog;
const KINDS: ['added' | 'improved' | 'fixed', IconName][] = [['added', 'plus'], ['improved', 'layers'], ['fixed', 'check']];
---
<Base lang={lang} path="changelog/" title={L.title} description={L.lead}>
  <section class="phero">
    <div class="wrap cl-hero"><p class="eyebrow">{L.title}</p><h1>{L.h1}</h1><p class="lead">{L.lead}</p></div>
  </section>
  <section class="msec">
    <div class="wrap">
      <div class="cl-tabs" role="group" aria-label={L.filter}>
        {(['all', 'desktop', 'site'] as const).map((k, i) => <button type="button" data-area={k} aria-pressed={i === 0 ? 'true' : 'false'}>{L.areas[k]}</button>)}
      </div>
      <ol class="cl-list">
        {L.releases.map(r => (
          <li data-area={r.area}>
            <div class="cl-when"><b>{r.version}</b><span>{r.date}</span></div>
            <article class="card cl-card">
              <header><span class="cl-ver">{r.version}</span><span class="cl-tag">{L.areas[r.area]}</span></header>
              <div class="cl-cols">
                {KINDS.filter(([k]) => r[k].length).map(([k, icon]) => (
                  <section><h3><span class={`cl-ic ${k}`}><Icon name={icon} size={14} /></span>{L.kinds[k]}</h3><ul>{r[k].map(x => <li>{x}</li>)}</ul></section>
                ))}
              </div>
            </article>
          </li>
        ))}
      </ol>
      <div class="cl-sub">
        <span class="tile acc"><Icon name="mail" size={22} /></span>
        <div><h2>{L.subscribe.title}</h2><p>{L.subscribe.body}</p></div>
        <form class="cl-sub-form" aria-disabled="true">
          <input type="email" placeholder={L.subscribe.placeholder} aria-label={L.subscribe.placeholder} disabled />
          <button class="btn btn-primary" type="button" disabled>{L.subscribe.soon}</button>
        </form>
      </div>
    </div>
  </section>
</Base>
<script>
  // One part of Folio at a time, or everything.
  const tabs = document.querySelectorAll<HTMLButtonElement>('.cl-tabs button');
  tabs.forEach(b => b.addEventListener('click', () => {
    tabs.forEach(x => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('.cl-list > li').forEach(li => { li.hidden = b.dataset.area !== 'all' && li.dataset.area !== b.dataset.area; });
  }));
</script>
<style>
  .cl-hero{padding-block:56px 52px}
  .cl-hero .eyebrow{color:var(--accent-ink)}
  .cl-hero h1{font-size:clamp(2rem,4.4vw,3.25rem);line-height:1.15}
  .cl-hero .lead{margin-top:14px;font-size:16px}
  .cl-tabs{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:28px}
  .cl-tabs button{height:var(--h-ctl);padding:0 18px;border:1px solid var(--line-2);border-radius:99px;background:var(--card);font:inherit;font-size:14px;color:var(--ink-2);cursor:pointer}
  .cl-tabs button:hover{color:var(--ink);border-color:var(--ink-3)}
  .cl-tabs button[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--on-accent);font-weight:600}
  .cl-list{display:grid;gap:22px;margin:0;padding:0;list-style:none}
  .cl-list > li{position:relative;display:grid;grid-template-columns:150px minmax(0,1fr);gap:24px}
  .cl-list > li::before{content:'';position:absolute;left:6px;top:24px;bottom:-22px;width:1px;background:color-mix(in srgb,var(--accent) 35%,var(--line))}
  .cl-list > li:last-child::before{display:none}
  .cl-when{position:relative;display:grid;align-content:start;gap:2px;padding:14px 0 0 24px}
  .cl-when::before{content:'';position:absolute;left:0;top:18px;width:13px;height:13px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px var(--accent-soft)}
  .cl-when b{font-size:16px}
  .cl-when span{font-size:13px;color:var(--ink-3)}
  .cl-card{padding:20px 24px}
  .cl-card header{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px}
  .cl-ver{padding:3px 12px;border-radius:99px;background:var(--accent-soft);color:var(--accent-ink);font:600 13px var(--f-data)}
  .cl-tag{padding:3px 10px;border-radius:99px;background:var(--seg);color:var(--ink-2);font-size:12px;font-weight:600}
  .cl-cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px 0}
  .cl-cols > section{padding-inline:0 22px}
  .cl-cols > section + section{padding-left:22px;border-left:1px solid var(--line)}
  .cl-cols h3{display:flex;align-items:center;gap:8px;margin-bottom:10px;font-size:15px}
  .cl-ic{display:grid;place-items:center;width:24px;height:24px;border-radius:50%}
  .cl-ic.added{background:var(--accent-soft);color:var(--accent-ink)}
  .cl-ic.improved{background:var(--info-soft);color:var(--info)}
  .cl-ic.fixed{background:var(--good-soft);color:var(--good-ink)}
  .cl-cols ul{display:grid;gap:8px;margin:0;padding-left:18px;list-style:disc;font-size:14px;line-height:1.65;color:var(--ink-2)}
  .cl-cols li::marker{color:var(--ink-3)}
  .cl-sub{display:grid;grid-template-columns:auto minmax(0,1fr) minmax(0,1fr);gap:20px;align-items:center;margin-top:44px;padding:28px 32px;border-radius:16px;background:var(--accent-soft);border:1px solid color-mix(in srgb,var(--accent) 16%,transparent)}
  .cl-sub h2{font-size:20px}
  .cl-sub p{margin-top:4px;font-size:14px;color:var(--ink-2)}
  .cl-sub-form{display:flex;gap:10px}
  .cl-sub-form input{flex:1;min-width:0;height:var(--h-ctl);padding:0 12px;border:1px solid var(--line-2);border-radius:var(--r);background:var(--card);font:inherit;font-size:14px}
  @media (max-width:860px){.cl-list > li{grid-template-columns:minmax(0,1fr)}.cl-list > li::before{display:none}.cl-sub{grid-template-columns:minmax(0,1fr);padding:22px 20px}}
  @media (max-width:720px){.cl-cols > section,.cl-cols > section + section{padding:0;border:0}}
</style>
