---
// What changed, release by release (v2): each card names the part of Folio (the workbench or the website) and the
// version, with when it came out, and lists what was added, improved and fixed; the buttons above show one part at a
// time. Below, subscribing to release news: an email with a link confirms it, and that email's links come back here
// (?confirm=, ?unsubscribe=).
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import type { IconName } from '../../lib/icons';
import { langPaths, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const L = t(lang).changelog;
const KINDS: ['added' | 'improved' | 'fixed', IconName][] = [['added', 'plus'], ['improved', 'layers'], ['fixed', 'check']];
---
<Base lang={lang} path="changelog/" title={L.title} description={L.lead}>
  <PageHero title={L.h1} lead={L.lead} />
  <section class="msec">
    <div class="wrap">
      <div class="cl-tabs" role="group" aria-label={L.filter}>
        {(['all', 'desktop', 'site'] as const).map((k, i) => <button type="button" data-area={k} aria-pressed={i === 0 ? 'true' : 'false'}>{L.areas[k]}</button>)}
      </div>
      <ol class="cl-list">
        {L.releases.map(r => (
          <li class="card cl-card" data-area={r.area}>
            <span class="cl-when">{r.date}</span>
            <h2>{L.areas[r.area]} · {r.version}</h2>
            <div class="cl-cols">
              {KINDS.filter(([k]) => r[k].length).map(([k, icon]) => (
                <section><h3><span class={`cl-ic ${k}`}><Icon name={icon} /></span>{L.kinds[k]}</h3><ul>{r[k].map(x => <li>{x}</li>)}</ul></section>
              ))}
            </div>
          </li>
        ))}
      </ol>
      <div class="cl-sub" id="subscribe">
        <div><h2>{L.subscribe.title}</h2><p>{L.subscribe.body}</p></div>
        <form class="cl-sub-form" id="sub-form" novalidate>
          <div class="field">
            <label for="sub-email">{L.subscribe.label}</label>
            <div class="cl-sub-row">
              <input type="email" id="sub-email" autocomplete="email" placeholder={L.subscribe.placeholder} required />
              <button class="btn btn-primary" type="submit">{L.subscribe.send}</button>
            </div>
          </div>
          <p class="cl-sub-msg" id="sub-msg" role="status" hidden></p>
        </form>
      </div>
    </div>
  </section>
</Base>
<script>
  import { api, errorText } from '../../lib/api';
  import { pageLang, t } from '../../lib/i18n';
  import { busy } from '../../scripts/session';
  // One part of Folio at a time, or everything.
  const tabs = document.querySelectorAll<HTMLButtonElement>('.cl-tabs button');
  tabs.forEach(b => b.addEventListener('click', () => {
    tabs.forEach(x => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('.cl-list > li').forEach(li => { li.hidden = b.dataset.area !== 'all' && li.dataset.area !== b.dataset.area; });
  }));

  const lang = pageLang(), d = t(lang), S = d.changelog.subscribe;
  const form = document.getElementById('sub-form') as HTMLFormElement, field = document.getElementById('sub-email') as HTMLInputElement;
  const msg = document.getElementById('sub-msg')!;
  const say = (text: string, ok: boolean) => { msg.textContent = text; msg.className = `cl-sub-msg ${ok ? 'ok' : 'bad'}`; msg.hidden = false; };
  // Subscribing sends the email that confirms it; an address already confirmed is told so.
  form.addEventListener('submit', async ev => {
    ev.preventDefault();
    const email = field.value.trim();
    if (!email || !field.checkValidity()){ say(d.errors.emailMissing, false); field.focus(); return; }
    const send = form.querySelector('button')!;
    busy(send, true);
    try {
      const { status } = await api<{ status: 'pending' | 'subscribed' }>('POST', '/news/subscribe', { email, locale: lang });
      say(status === 'subscribed' ? S.subscribed : S.pending(email), true);
    } catch (e){ say(errorText(d, e), false); } finally { busy(send, false); }
  });
  // The email's links: confirming or unsubscribing happens here, and the box says how it went.
  const query = new URLSearchParams(location.search);
  for (const [name, path, done] of [['confirm', '/news/confirm', S.confirmed], ['unsubscribe', '/news/unsubscribe', S.unsubscribed]] as const){
    const token = query.get(name);
    if (!token) continue;
    history.replaceState(null, '', location.pathname);
    api('POST', path, { token }).then(() => say(done, true), () => say(S.badLink, false))
      .finally(() => document.getElementById('subscribe')!.scrollIntoView({ block: 'center' }));
  }
</script>
<style>
  .cl-tabs{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:24px}
  .cl-tabs button{height:var(--h-ctl);padding:0 18px;border:1px solid var(--line-2);border-radius:99px;background:var(--card);font:inherit;font-size:14px;color:var(--ink-2);cursor:pointer}
  .cl-tabs button:hover{color:var(--ink);border-color:var(--ink-3)}
  .cl-tabs button[aria-pressed="true"]{background:var(--action);border-color:var(--action);color:var(--on-accent);font-weight:600}
  /* v2: one card per release, the date in a grey label, the part and version 28/40, then what changed */
  .cl-list{display:grid;gap:32px;margin:0;padding:0;list-style:none}
  .cl-card{display:grid;justify-items:start;gap:12px;padding:22px 24px 26px}
  .cl-when{display:inline-flex;align-items:center;height:26px;padding:0 10px;border-radius:99px;background:var(--seg);font-size:12px;font-weight:500;color:var(--ink-3)}
  .cl-card > h2{font-size:28px;line-height:40px}
  .cl-cols{justify-self:stretch;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px 0;margin-top:4px}
  .cl-cols > section{padding-inline:0 24px}
  .cl-cols > section + section{padding-left:24px;border-left:1px solid var(--line)}
  .cl-cols h3{display:flex;align-items:center;gap:8px;margin-bottom:10px;font-size:16px}
  .cl-ic{display:grid;place-items:center;width:24px;height:24px;border-radius:50%}
  .cl-ic.added{background:var(--accent-soft);color:var(--accent-ink)}
  .cl-ic.improved{background:var(--info-soft);color:var(--info-ink)}
  .cl-ic.fixed{background:var(--good-soft);color:var(--good-ink)}
  .cl-cols ul{display:grid;gap:8px;margin:0;padding-left:18px;list-style:disc;font-size:16px;line-height:28px;color:var(--ink-body)}
  .cl-cols li::marker{color:var(--ink-3)}
  /* subscribing: the closing band of the page (v2's band), the address with its label beside what it is */
  .cl-sub{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,460px);gap:24px 48px;align-items:center;margin-top:48px;padding:28px 48px 28px 32px;border-radius:var(--r-card);background:var(--accent-soft)}
  .cl-sub h2{font-size:28px;line-height:40px}
  .cl-sub p{margin-top:4px;font-size:16px;line-height:28px;color:var(--ink-3)}
  .cl-sub-row{display:flex;gap:12px}
  .cl-sub-row input{flex:1;min-width:0}
  .cl-sub-row .btn{min-width:96px}
  .cl-sub-msg{margin-top:10px;font-size:14px;line-height:1.6}
  .cl-sub-msg.ok{color:var(--good-ink)}
  .cl-sub-msg.bad{color:var(--bad-ink)}
  @media (max-width:900px){.cl-sub{grid-template-columns:minmax(0,1fr);padding:24px 20px}}
  @media (max-width:720px){.cl-cols > section,.cl-cols > section + section{padding:0;border:0}}
</style>
