---
import DocPage from '../../components/DocPage.astro';
import { langPaths, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang);
---
<DocPage lang={lang} path="changelog/" title={d.docs.changelogTitle}>
  <dl class="entries">{d.docs.changelog.map(([v, text]) => <div><dt>{v}</dt><dd>{text}</dd></div>)}</dl>
</DocPage>
