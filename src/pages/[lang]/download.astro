---
// Downloads (v2): the release and where to get it safely; the installers for Windows and macOS (disabled, and saying
// so, while no release is configured) and a way to ask about other systems; the three steps from installing to the
// first browser profile, and the installation guide.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import { day } from '../../lib/format';
import type { IconName } from '../../lib/icons';
import { INSTALLERS } from '../../lib/installers';
import { langPaths, link, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang).download;
// The latest release's version and date come with the build (README); without them the page says the installers are
// coming.
const version = import.meta.env.PUBLIC_DESKTOP_VERSION;
const released = import.meta.env.PUBLIC_DESKTOP_RELEASED;
const systems: { os: string; icon: IconName; req: string; note: string; href: string | null; primary: boolean }[] = [
  { os: d.windowsName, icon: 'windows', req: d.windows, note: d.winNote, href: INSTALLERS.windows, primary: true },
  { os: d.macName, icon: 'apple', req: d.mac, note: d.macNote, href: INSTALLERS.mac, primary: false }
];
---
<Base lang={lang} path="download/" title={d.title} description={d.lead}>
  <PageHero title={d.h1} lead={d.lead}>
    <p class="notice" data-version={version || undefined}>{d.status(version ? `${d.version(version)}${released ? ` · ${d.released(day(released, lang))}` : ''}` : null)}</p>
  </PageHero>

  <section class="msec">
    <div class="wrap cols grid-3">
      {systems.map(s => (
        <div class="fcard dl-card">
          <Icon name={s.icon} size={24} />
          <h2>{s.os}</h2>
          <p>{s.req}</p>
          {s.href
            ? <a class={`btn ${s.primary ? 'btn-primary' : 'btn-secondary'} btn-lg full`} href={s.href}><Icon name="download" />{d.get(s.os)}</a>
            : <button class="btn btn-secondary btn-lg full" type="button" disabled>{d.soon}</button>}
          <details class="dl-note"><summary><Icon name="alert" />{d.notesTitle}</summary><p>{s.note}</p></details>
        </div>
      ))}
      <div class="fcard dl-card">
        <Icon name="help" size={24} />
        <h2>{d.otherName}</h2>
        <p>{d.other}</p>
        <a class="btn btn-secondary btn-lg full" href={link(lang, 'contact/')}>{d.contact}</a>
      </div>
    </div>
  </section>

  <section class="msec">
    <div class="wrap">
      <div class="msec-head"><h2>{d.stepsTitle}</h2><p>{d.stepsLead}</p></div>
      <ol class="cols steps-row">{d.steps.map(([title, body]) => <li><b>{title}</b><p>{body}</p></li>)}</ol>
      <a class="btn btn-secondary btn-lg dl-guide" href={link(lang, 'help/install/')}>{d.guide}</a>
    </div>
  </section>
</Base>
<style>
  .dl-card h2{margin-top:26px;font-size:20px;line-height:28px}
  /* the buttons in one line across the three cards: what each is for takes up to two lines */
  .dl-card > p{min-height:56px;margin-bottom:24px}
  .dl-note{align-self:stretch;margin-top:16px;padding-top:14px;border-top:1px dashed var(--line-2);font-size:14px;color:var(--ink-3)}
  .dl-note summary{display:flex;align-items:center;gap:6px;list-style:none;font-weight:600;color:var(--ink);cursor:pointer}
  .dl-note summary::-webkit-details-marker{display:none}
  .dl-note p{margin-top:8px;font-size:14px;line-height:22px;overflow-wrap:anywhere}
  .dl-guide{margin-top:40px}
</style>
