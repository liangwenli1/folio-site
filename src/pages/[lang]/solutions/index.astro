---
// Solutions (v2): three ways of working Folio fits, each with where to read more (the first has a page of its own),
// the four steps a team takes to set it up, and questions.
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import PageHero from '../../../components/PageHero.astro';
import Faq from '../../../components/Faq.astro';
import type { IconName } from '../../../lib/icons';
import { langPaths, link, t, type Lang } from '../../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const S = t(lang).solutions;
const CASES: [IconName, string][] = [['cart', 'solutions/ecommerce/'], ['chat', 'features/#automation'], ['code', 'features/#team']];
---
<Base lang={lang} path="solutions/" title={S.title} description={S.lead}>
  <PageHero title={S.h1} lead={S.lead} />

  <section class="msec">
    <div class="wrap cols grid-3">
      {S.cases.map((c, i) => (
        <article class="fcard"><Icon name={CASES[i][0]} size={24} /><h3>{c.title}</h3><p>{c.lead}</p><a class="more" href={link(lang, CASES[i][1])}>{S.more}</a></article>
      ))}
    </div>
  </section>

  <section class="msec">
    <div class="wrap">
      <div class="msec-head"><h2>{S.flow.title}</h2><p>{S.flow.lead}</p></div>
      <ol class="cols steps-row four">{S.flow.steps.map(([title, body]) => <li><b>{title}</b><p>{body}</p></li>)}</ol>
    </div>
  </section>

  <section class="msec">
    <div class="wrap"><Faq title={S.faq.title} lead={S.faq.lead} items={S.faq.items} /></div>
  </section>
</Base>
