---
// Cross-border e-commerce (v2): running shops on several platforms in several regions beside a picture of groups in the
// real workbench; what gets in the way and how Folio answers it; the four steps that set it up; and a note that each
// platform's own rules apply.
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import PageHero from '../../../components/PageHero.astro';
import Shot from '../../../components/Shot.astro';
import type { IconName } from '../../../lib/icons';
import { langPaths, link, t, type Lang } from '../../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang), E = d.ecommerce;
const PAINS: IconName[] = ['folder', 'proxies', 'team'];
---
<Base lang={lang} path="solutions/ecommerce/" title={E.title} description={E.lead}>
  <PageHero title={E.h1} lead={E.lead}>
    <div class="cta-row"><a class="btn btn-primary btn-lg" href={link(lang, 'signup/')}>{d.nav.start}</a></div>
    <Shot slot="vis" lang={lang} name="groups" alt={E.shot} zoom={1.2} origin="100% 0" eager />
  </PageHero>

  <section class="msec">
    <div class="wrap">
      <div class="msec-head"><h2>{E.pains.title}</h2><p>{E.pains.lead}</p></div>
      <div class="cols grid-3">
        {E.pains.items.map(([title, body, fix], i) => (
          <article class="fcard"><Icon name={PAINS[i]} size={24} /><h3>{title}</h3><p>{body}</p><p class="fix"><Icon name="check" />{fix}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="msec">
    <div class="wrap">
      <div class="msec-head"><h2>{E.flow.title}</h2><p>{E.flow.lead}</p></div>
      <ol class="cols steps-row four">{E.flow.steps.map(([title, body]) => <li><b>{title}</b><p>{body}</p></li>)}</ol>
      <p class="notice enote">{E.note}</p>
    </div>
  </section>
</Base>
<style>
  /* how Folio answers it, at the card's foot */
  .fcard .fix{display:flex;gap:8px;margin-top:auto;padding-top:20px;font-size:16px;font-weight:500;line-height:24px;color:var(--ink)}
  .fix :global(.i){flex:none;margin-top:4px;color:var(--good-ink)}
  .enote{margin-top:48px}
</style>
