---
// Cross-border e-commerce: running shops on several platforms in several regions, what gets in the way and how Folio
// answers it, the four steps that set it up (each drawn as the part of the workbench where it happens), and the
// work before and after.
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import PageHero from '../../../components/PageHero.astro';
import Shot from '../../../components/Shot.astro';
import type { IconName } from '../../../lib/icons';
import { langPaths, link, t, type Lang } from '../../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang), E = d.ecommerce, M = E.flow.mini;
const PAINS: [IconName, IconName][] = [['grid', 'folder'], ['link', 'layers'], ['user', 'team']];
---
<Base lang={lang} path="solutions/ecommerce/" title={E.title} description={E.lead}>
  <PageHero lang={lang} title={E.h1} lead={E.lead} crumbs={[[d.solutions.title, link(lang, 'solutions/')], [E.crumb, null]]}>
    <div class="cta-row">
      <a class="btn btn-primary btn-lg" href={link(lang, 'signup/')}>{d.solutions.start}<Icon name="chevr" /></a>
      <a class="btn btn-secondary btn-lg" href={link(lang, 'features/')}>{E.features}</a>
    </div>
    <Shot slot="vis" lang={lang} name="groups" alt={E.shot} zoom={1.2} origin="100% 0" eager />
  </PageHero>

  <section class="msec">
    <div class="wrap">
      <div class="ehead"><h2>{E.pains.title}</h2><p>{E.pains.lead}</p></div>
      <div class="grid-3">
        {E.pains.items.map(([title, body, fix, how], i) => (
          <article class="card pain">
            <div class="pain-q"><span class="tile acc"><Icon name={PAINS[i][0]} size={20} /></span><div><h3>{title}</h3><p>{body}</p></div></div>
            <span class="pain-to" aria-hidden="true"><Icon name="chev" /></span>
            <div class="pain-a"><Icon name={PAINS[i][1]} size={22} /><div><b>{fix}</b><small>{how}</small></div></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="msec alt">
    <div class="wrap">
      <div class="ehead"><h2>{E.flow.title}</h2><p>{E.flow.lead}</p></div>
      <ol class="eflow">
        <li>
          <h3>{E.flow.steps[0]}</h3>
          <div class="mini" aria-hidden="true">
            <b class="mini-t">{M.groups.title}</b>
            {M.groups.items.map(g => <span class="mini-row"><Icon name="folder" />{g}</span>)}
            <span class="mini-btn"><Icon name="plus" />{M.groups.add}</span>
          </div>
        </li>
        <li>
          <h3>{E.flow.steps[1]}</h3>
          <div class="mini" aria-hidden="true">
            <b class="mini-t">{M.profile.title}</b>
            {M.profile.fields.map(([k, v]) => <span class="mini-field"><small>{k}</small><span>{v}</span></span>)}
            <span class="mini-btn">{M.profile.create}</span>
          </div>
        </li>
        <li>
          <h3>{E.flow.steps[2]}</h3>
          <div class="mini" aria-hidden="true">
            <b class="mini-t">{M.proxy.title}</b>
            {M.proxy.fields.map(([k, v]) => <span class="mini-field"><small>{k}</small><span class="mono">{v}</span></span>)}
            <span class="mini-btn ghost">{M.proxy.check}</span>
            <span class="mini-ok"><Icon name="check" size={12} />{M.proxy.ok}<small>{M.proxy.exit}</small></span>
          </div>
        </li>
        <li>
          <h3>{E.flow.steps[3]}</h3>
          <div class="mini" aria-hidden="true">
            <b class="mini-t">{M.access.title}</b>
            {M.access.people.map(([name, role, on]) => <span class="mini-row"><span class={on ? 'mini-cb on' : 'mini-cb'}>{on && <Icon name="check" size={10} />}</span>{name}<em>{role}</em></span>)}
            <span class="mini-btn">{M.access.save}</span>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="msec">
    <div class="wrap">
      <div class="ehead"><h2>{E.compare.title}</h2><p>{E.compare.lead}</p></div>
      <div class="ba">
        <figure class="card ba-before">
          <figcaption><b>{E.compare.before}</b><span>{E.compare.beforeSub}</span></figcaption>
          <div class="tbl-scroll">
            <table>
              <thead><tr>{E.compare.cols.map(c => <th scope="col">{c}</th>)}</tr></thead>
              <tbody>{E.compare.rows.map(r => <tr>{r.map((c, i) => <td class={i === r.length - 1 ? 'bad' : undefined}>{c}</td>)}</tr>)}</tbody>
            </table>
          </div>
        </figure>
        <span class="ba-to" aria-hidden="true"><Icon name="chevr" size={22} /></span>
        <figure class="ba-after">
          <figcaption><b>{E.compare.after}</b><span>{E.compare.afterSub}</span></figcaption>
          <Shot lang={lang} name="list" alt={E.compare.afterShot} zoom={1.2} origin="100% 0" />
        </figure>
      </div>
      <p class="enote"><Icon name="info" size={15} />{E.note}</p>
    </div>
  </section>
</Base>
<style>
  .ehead{max-width:720px;margin-bottom:36px}
  .ehead h2{font-size:clamp(1.75rem,3vw,2.25rem);line-height:1.25}
  .ehead p{margin-top:10px;color:var(--ink-2)}
  .pain{display:grid;gap:14px;padding:24px}
  .pain-q{display:flex;gap:14px}
  .pain h3{font-size:18px}
  .pain-q p{margin-top:6px;font-size:14px;line-height:1.7;color:var(--ink-2)}
  .pain-to{justify-self:center;color:var(--ink-3)}
  .pain-a{display:flex;gap:12px;align-items:center;padding:14px 16px;border-radius:var(--r-card);background:var(--accent-soft);color:var(--accent-ink)}
  .pain-a b{display:block;font-size:14.5px;color:var(--ink)}
  .pain-a small{display:block;font-size:13px;color:var(--ink-2)}
  .eflow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;margin:0;padding:0;list-style:none;counter-reset:step}
  .eflow > li{position:relative;display:grid;gap:14px;align-content:start;counter-increment:step}
  .eflow > li + li::before{content:'›';position:absolute;left:-17px;top:48%;font-size:22px;color:var(--ink-3)}
  .eflow h3{display:flex;align-items:center;gap:12px;font-size:17px}
  .eflow h3::before{content:counter(step);display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:var(--accent);color:var(--on-accent);font:600 14px var(--f-data)}
  /* the shared small panels (site.css), a little larger here */
  .eflow .mini{min-height:220px;align-content:start;gap:9px;padding:16px;background:var(--card);box-shadow:var(--shadow);font-size:13px}
  .eflow .mini-row{height:34px}
  .eflow .mini-field{grid-template-columns:72px minmax(0,1fr)}
  html[lang="en"] .eflow .mini-field{grid-template-columns:84px minmax(0,1fr)}
  .eflow .mini-field > span{height:32px;line-height:30px}
  .eflow .mini-btn{height:30px;padding:0 12px;font-size:12.5px}
  .mini-btn.ghost{justify-self:stretch;justify-content:center;background:var(--card);color:var(--accent-ink);border:1px solid color-mix(in srgb,var(--accent) 50%,transparent)}
  .mini-ok{display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px;padding:8px 10px;border-radius:var(--r);background:var(--good-soft);color:var(--good-ink);font-weight:600}
  .mini-ok small{flex-basis:100%;font-weight:400;color:var(--ink-2)}
  .mini-cb{display:grid;place-items:center;width:16px;height:16px;flex:none;border-radius:4px;border:1.5px solid var(--line-2)}
  .mini-cb.on{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
  @media (max-width:1000px){.eflow{grid-template-columns:repeat(2,minmax(0,1fr))}.eflow > li + li::before{display:none}}
  @media (max-width:560px){.eflow{grid-template-columns:minmax(0,1fr)}}
  .ba{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);gap:20px;align-items:center}
  .ba figure{margin:0;min-width:0}
  .ba figcaption{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px;margin-bottom:12px}
  .ba-before figcaption{margin:0;padding:16px 18px;border-bottom:1px solid var(--line)}
  .ba figcaption b{font-size:16px}
  .ba figcaption span{font-size:13.5px;color:var(--ink-2)}
  .ba-after figcaption b{color:var(--accent-ink)}
  .ba-before{overflow:hidden}
  .ba-before table{width:100%;min-width:480px;border-collapse:collapse;font-size:13px}
  .ba-before th,.ba-before td{height:44px;padding:0 14px;text-align:left;border-bottom:1px solid var(--line)}
  .ba-before th{font-size:12px;font-weight:500;color:var(--ink-3);background:var(--head)}
  .ba-before tbody tr:last-child td{border-bottom:0}
  .ba-before td.bad{color:var(--bad-ink)}
  .ba-to{color:var(--accent)}
  @media (max-width:960px){.ba{grid-template-columns:minmax(0,1fr)}.ba-to{justify-self:center;rotate:90deg}}
  .enote{display:flex;align-items:center;gap:8px;margin-top:28px;padding:12px 16px;border-radius:var(--r-card);background:var(--panel);border:1px solid var(--line);font-size:14px;color:var(--ink-2)}
  .enote :global(.i){color:var(--info)}
</style>
