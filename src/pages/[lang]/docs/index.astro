---
import DocPage from '../../../components/DocPage.astro';
import { langPaths, link, t, type Lang } from '../../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang);
---
<DocPage lang={lang} path="docs/" title={d.docs.title} lead={d.docs.lead}>
  <p><a href={link(lang, 'docs/api/')}>{d.docs.apiTitle}</a> · <a href={link(lang, 'changelog/')}>{d.docs.changelogTitle}</a></p>
</DocPage>
