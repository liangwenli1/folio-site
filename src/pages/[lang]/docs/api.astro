---
import DocPage from '../../../components/DocPage.astro';
import { langPaths, t, type Lang } from '../../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang);
const A = d.docs.api;

const start = `const res = await fetch('http://127.0.0.1:47210/api/v1/profiles/0042/start', {
  method: 'POST', headers: { authorization: 'Bearer <token>' }
});
const { wsEndpoint } = await res.json();`;
const examples: [keyof typeof A.examples, string][] = [
  ['playwright', `import { chromium } from 'playwright';

${start}
const browser = await chromium.connectOverCDP(wsEndpoint);
const page = browser.contexts()[0].pages()[0];
await page.goto('https://seller.example.com');`],
  ['puppeteer', `import puppeteer from 'puppeteer-core';

${start}
const browser = await puppeteer.connect({ browserWSEndpoint: wsEndpoint });
const [page] = await browser.pages();
await page.goto('https://seller.example.com');`],
  ['selenium', `import requests
from selenium import webdriver

r = requests.post('http://127.0.0.1:47210/api/v1/profiles/0042/start',
                  headers={'Authorization': 'Bearer <token>'}).json()
options = webdriver.ChromeOptions()
options.debugger_address = r['debuggerAddress']
driver = webdriver.Chrome(options=options)
driver.get('https://seller.example.com')`],
  ['firefox', `import puppeteer from 'puppeteer-core';

${start}  // ws://127.0.0.1:…/session
const browser = await puppeteer.connect({ browserWSEndpoint: wsEndpoint, protocol: 'webDriverBiDi' });
const [page] = await browser.pages();
await page.goto('https://seller.example.com');`]
];
---
<DocPage lang={lang} path="docs/api/" title={d.docs.apiTitle} lead={d.docs.apiLead}>
  <h2>{A.setupTitle}</h2>
  {A.setup.map(p => <p>{p}</p>)}

  <h2>{A.limitsTitle}</h2>
  <p>{A.limits}</p>

  <h2>{A.enginesTitle}</h2>
  <dl class="entries">{A.engines.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>

  <h2>{A.endpointsTitle}</h2>
  <p>{A.endpointsLead}</p>
  <table class="ref">
    <tbody>{A.endpoints.map(([m, path, what]) => <tr><td class="route"><b>{m}</b> {path}</td><td>{what}</td></tr>)}</tbody>
  </table>

  <h2>{A.errorsTitle}</h2>
  <p>{A.errorsLead}</p>
  <table class="ref">
    <tbody>{A.errors.map(([status, code, what]) => <tr><td class="route"><b>{status}</b> {code}</td><td>{what}</td></tr>)}</tbody>
  </table>

  <h2>{A.examplesTitle}</h2>
  {examples.map(([k, code]) => <><h3>{A.examples[k]}</h3><pre class="code"><code>{code}</code></pre></>)}

  <h2>{A.securityTitle}</h2>
  <p>{A.security}</p>
</DocPage>
<style>
  h2{margin:36px 0 12px;font-family:var(--f-display);font-size:24px;line-height:1.2}
  h3{margin:22px 0 8px;font-size:15px}
  .ref{width:100%;border-collapse:collapse;font-size:14px;margin-top:12px}
  .ref td{padding:10px 12px;border-top:1px solid var(--line);vertical-align:top}
  .ref tr:last-child td{border-bottom:1px solid var(--line)}
  .ref .route{font-family:var(--f-data);font-size:12.5px;white-space:nowrap;color:var(--ink-2)}
  .ref .route b{color:var(--ink);font-weight:500}
  .code{margin:0;background:var(--code-bg);color:var(--code-fg);border:1px solid var(--line);border-radius:8px;padding:18px 20px;overflow-x:auto;font-family:var(--f-data);font-size:12.5px;line-height:1.75}
  @media (max-width:700px){ .ref .route{white-space:normal} .ref td{display:block;border-top:0;padding:4px 0} .ref tr{display:block;padding:8px 0;border-top:1px solid var(--line)} }
</style>
