---
// The terms of service, still a draft (v2): the clauses from what the service covers to liability and disputes, and
// when they take effect, with the contents beside them as on the privacy policy (following the reading, folding on a
// phone). Items not settled yet say so.
import Base from '../../layouts/Base.astro';
import Contents from '../../components/Contents.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { langPaths, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const L = t(lang).legal, T = L.terms;
const id = (i: number) => `s${i + 1}`;
---
<Base lang={lang} path="terms/" title={T.title} description={T.lead}>
  <PageHero title={T.title} lead={T.lead}><p class="notice">{T.draft}</p></PageHero>
  <Contents lang={lang} sections={T.sections.map((s, i): [string, string] => [id(i), s.title])}>
    {T.sections.map((s, i) => (
      <section class="lt-sec" id={id(i)} aria-labelledby={`${id(i)}-h`}>
        <h2 id={`${id(i)}-h`}>{s.title}</h2>
        {s.body.map(p => <p>{p}</p>)}
      </section>
    ))}
    <p class="lt-eff"><Icon name="calendar" /><span>{T.effective}<span class="tbc">{L.tbc}</span></span><span>{T.effectiveBody}</span></p>
  </Contents>
</Base>
<style>
  /* v2: each clause's title 24/34 and its text 16/28 */
  .lt-sec{display:grid;gap:12px}
  .lt-sec h2{margin-bottom:8px;font-size:24px;line-height:34px}
  .lt-sec p{max-width:820px;font-size:16px;line-height:28px;color:var(--ink-body)}
  .lt-eff{display:flex;flex-wrap:wrap;align-items:center;gap:8px 20px;padding:14px 20px;border-radius:var(--r-card);background:var(--panel);font-size:14px;color:var(--ink-3)}
  .lt-eff :global(.i){color:var(--ink-3)}
</style>
