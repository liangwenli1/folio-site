---
import DocPage from '../../components/DocPage.astro';
import { langPaths, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const l = t(lang).legal;
---
<DocPage lang={lang} path="terms/" title={l.termsTitle} draft={l.draft}>
  {l.termsBody.map(p => <p class="doc-body">{p}</p>)}
</DocPage>
