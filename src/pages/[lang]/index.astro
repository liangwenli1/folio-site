---
// The home page: what Folio is beside the walkthrough of the real workbench, the four things it manages (each with a
// small piece of the workbench), three steps to start, the kinds of work it suits, questions, and a way to start.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import Showcase from '../../components/Showcase.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import type { IconName } from '../../lib/icons';
import { langPaths, link, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang), H = d.home, K = H.cards;
const POINTS: IconName[] = ['lock', 'proxies', 'team'];
const CARDS: IconName[] = ['profiles', 'proxies', 'folder', 'team'];
const USES: [IconName, string][] = [['cart', 'solutions/ecommerce/'], ['chat', 'solutions/'], ['code', 'solutions/']];
---
<Base lang={lang} path="">
  <PageHero lang={lang} title={H.h1} lead={H.lead}>
    <div class="cta-row">
      <a class="btn btn-primary btn-lg" href={link(lang, 'signup/')}>{d.nav.start}<Icon name="chevr" /></a>
      <a class="btn btn-secondary btn-lg" href={link(lang, 'features/')}>{H.features}</a>
    </div>
    <ul class="phero-pts">
      {H.points.map(([b, s], i) => <li><span class="tile acc"><Icon name={POINTS[i]} size={18} /></span><span><b>{b}</b><small>{s}</small></span></li>)}
    </ul>
    <div slot="vis" class="home-vis"><Showcase lang={lang} label={d.demo.label} pause={d.demo.pause} play={d.demo.play} /></div>
  </PageHero>

  <section class="msec alt">
    <div class="wrap">
      <div class="msec-head"><h2>{H.cardsTitle}</h2><p>{H.cardsLead}</p></div>
      <div class="grid-4">
        {K.map((c, i) => (
          <article class="card hcard">
            <span class="tile acc"><Icon name={CARDS[i]} size={20} /></span>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
            <div class="mini" aria-hidden="true">
              <b class="mini-t">{c.mini.title}</b>
              {c.mini.rows.map(([k, v]) => k
                ? <span class="mini-field"><small>{k}</small><span>{v}</span></span>
                : <span class="mini-row">{v}</span>)}
              <span class="mini-btn">{c.mini.button}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="msec">
    <div class="wrap">
      <div class="msec-head"><h2>{H.steps.title}</h2><p>{H.steps.lead}</p></div>
      <ol class="steps-row">{H.steps.items.map(([b, s]) => <li><b>{b}</b><p>{s}</p></li>)}</ol>
    </div>
  </section>

  <section class="msec alt">
    <div class="wrap">
      <div class="msec-head"><h2>{H.uses.title}</h2><p>{H.uses.lead}</p></div>
      <div class="grid-3">
        {H.uses.items.map((u, i) => (
          <a class="card huse" href={link(lang, USES[i][1])}>
            <div><span class="tile acc"><Icon name={USES[i][0]} size={20} /></span><h3>{u.title}</h3><p>{u.body}</p></div>
            <ul class="huse-list" aria-hidden="true">{u.list.map(x => <li><Icon name="profiles" size={12} />{x}</li>)}</ul>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="msec">
    <div class="wrap"><Faq title={H.faq.title} lead={H.faq.lead} contact={{ label: H.faq.contact, href: link(lang, 'contact/') }} items={H.faq.items} /></div>
  </section>

  <section class="msec cta-sec">
    <div class="wrap">
      <CtaBand title={H.band.title} body={H.band.body}>
        <a class="btn btn-primary btn-lg" href={link(lang, 'signup/')}>{d.nav.start}<Icon name="chevr" /></a>
        <a class="btn btn-secondary btn-lg" href={link(lang, 'download/')}><Icon name="download" />{H.band.download}</a>
      </CtaBand>
    </div>
  </section>
</Base>
<style>
  .home-vis{position:relative}
  .home-vis :global(.showcase){position:relative;width:100%}
  .hcard{display:flex;flex-direction:column;gap:10px;padding:24px}
  .hcard h3{margin-top:6px;font-size:18px}
  .hcard > p{font-size:14px;line-height:1.7;color:var(--ink-2)}
  .hcard .mini{margin-top:auto}
  .huse{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.85fr);gap:18px;padding:22px;text-decoration:none;color:inherit;transition:border-color .15s ease,box-shadow .15s ease}
  .huse:hover{border-color:color-mix(in srgb,var(--accent) 40%,var(--line));box-shadow:var(--shadow-pop)}
  .huse h3{margin-top:12px;font-size:18px}
  .huse p{margin-top:6px;font-size:14px;line-height:1.7;color:var(--ink-2)}
  .huse-list{display:grid;gap:6px;align-content:center;margin:0;padding:12px;border-radius:var(--r-card);background:var(--panel);border:1px solid var(--line);list-style:none;font-size:12px}
  .huse-list li{display:flex;align-items:center;gap:7px;height:28px;padding:0 9px;border-radius:6px;background:var(--card);border:1px solid var(--line);white-space:nowrap;overflow:hidden}
  .huse-list :global(.i){color:var(--ink-3)}
  @media (max-width:560px){.huse{grid-template-columns:minmax(0,1fr)}}
</style>
