---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../lib/icons';
import Showcase from '../../components/Showcase.astro';
import SampleProfile from '../../components/SampleProfile.astro';
import '../../styles/landing.css';
import { langPaths, link, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang);
const h = d.hero;
const WHO: IconName[] = ['profiles', 'proxies', 'team'];
const TRUST: IconName[] = ['dice', 'search', 'restore', 'upload'];
const AVATARS = ['#D2445E', '#2F6FD6', '#1E8A63', '#C98A12'];
---
<Base lang={lang} path="" overHero>
  <section class="hero" id="top">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap hero-in">
      <div class="hero-copy">
        <p class="eyebrow">{h.eyebrow}</p>
        <h1>{h.h1}</h1>
        <p class="lead">{h.lead}</p>
        <div class="cta-row">
          <a class="btn btn-primary btn-lg" href={link(lang, 'signup/')}>{h.ctaStart}</a>
          <a class="btn btn-secondary btn-lg" href={link(lang, 'download/')}><Icon name="windows" />{h.ctaDownload}</a>
        </div>
        <p class="fine">{h.fine}</p>
      </div>
      <div class="hero-vis">
        <Showcase lang={lang} label={h.showcase.label} />
        <SampleProfile lang={lang} />
      </div>
    </div>
  </section>
  <div class="wrap"><div class="spec">{h.spec.map(([b, s]) => <div><b>{b}</b><span>{s}</span></div>)}</div></div>

  <section class="sec" id="who">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">{d.who.eyebrow}</p><h2>{d.who.title}</h2><p class="lead">{d.who.lead}</p></div>
      <div class="who-grid">
        {d.who.items.map((w, i) => (
          <article class="card who">
            <span class="tile"><Icon name={WHO[i]} size={18} /></span>
            <p class="who-tag">{w.tag}</p>
            <h3>{w.title}</h3>
            <p>{w.body}</p>
            <p class="who-fit"><Icon name="check" size={12} />{w.fit}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec-alt">
    <div class="wrap rows">
      <div class="frow" id="inside">
        <div>
          <p class="eyebrow">{d.inside.eyebrow}</p>
          <h2>{d.inside.title}</h2>
          <p class="lead">{d.inside.note}</p>
          <div class="groups">
            {d.inside.groups.map(([g, chips]) => (
              <div class="grp"><b>{g}</b><ul>{chips.map(c => <li><Icon name="check" size={11} />{c}</li>)}</ul></div>
            ))}
          </div>
        </div>
        <figure class="shot"><img src="/showcase/check.webp" width="1280" height="1080" alt="" style="object-position:100% 0" /></figure>
      </div>

      <div class="frow flip" id="team">
        <div>
          <p class="eyebrow">{d.team.eyebrow}</p>
          <h2>{d.team.title}</h2>
          <p class="lead">{d.team.lead}</p>
          <ul class="pts">{d.team.points.map(([b, s]) => <li><span class="tick"><Icon name="check" size={12} /></span><div><b>{b}</b><p>{s}</p></div></li>)}</ul>
        </div>
        <figure class="card tpanel" aria-label={d.team.example}>
          <div class="tpanel-head"><b>{d.team.panelTitle}</b><span class="mono">{d.team.panelMeta}</span></div>
          {d.team.members.map(([ini, name, role, gone], i) => (
            <div class={gone ? 'member gone' : 'member'}>
              <span class="av" style={`--c:${AVATARS[i]}`} aria-hidden="true">{ini}</span>
              <span class="mname"><b>{name}</b><small>{role}</small></span>
              <span class={gone ? 'chip' : 'chip ok'}><Icon name={gone ? 'pause' : 'check'} size={12} />{gone ? d.team.left : d.team.active}</span>
            </div>
          ))}
          <div class="tlog">
            <p>{d.team.logTitle}</p>
            {d.team.log.map(([time, text]) => <div><time>{time}</time><span>{text}</span></div>)}
          </div>
        </figure>
      </div>

      <div class="frow" id="auto">
        <div>
          <p class="eyebrow">{d.auto.eyebrow}</p>
          <h2>{d.auto.title}</h2>
          <h3 class="sub-h">{d.auto.noCode}</h3>
          <ul class="pts">{d.auto.noCodePoints.map(([b, s]) => <li><span class="tick"><Icon name="check" size={12} /></span><div><b>{b}</b><p>{s}</p></div></li>)}</ul>
          <h3 class="sub-h">{d.auto.withCode}</h3>
          <p class="lead">{d.auto.withCodeBody}</p>
          <ul class="libs">{d.auto.libs.map(l => <li>{l}</li>)}</ul>
        </div>
        <figure class="shot"><img src="/showcase/sync.webp" width="1280" height="1080" alt="" style="object-position:0 0" /></figure>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <figure class="card compare">
        <figcaption><b>{d.inside.compareTitle}</b><span>{d.inside.compareHint}</span></figcaption>
        <div class="tbl-scroll">
          <table>
            <thead><tr>{d.inside.cols.map(c => <th scope="col">{c}</th>)}</tr></thead>
            <tbody>
              {d.inside.rows.map(([k, a, b, marked]) => (
                <tr>
                  <th scope="row">{k}</th>
                  <td class={marked ? 'bad' : ''}>{marked && <span class="mk" role="img" aria-label={d.inside.leak}><Icon name="x" size={11} /></span>}{a}</td>
                  <td class="good">{marked && <span class="mk" role="img" aria-label={d.inside.match}><Icon name="check" size={11} /></span>}{b}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </figure>
    </div>
  </section>

  <section class="sec sec-alt" id="trust">
    <div class="wrap">
      <div class="sec-head c"><p class="eyebrow">{d.trust.eyebrow}</p><h2>{d.trust.title}</h2></div>
      <div class="trust-grid">{d.trust.items.map(([b, s], i) => <div class="card trust"><span class="tile"><Icon name={TRUST[i]} size={18} /></span><h3>{b}</h3><p>{s}</p></div>)}</div>
    </div>
  </section>

  <section class="sec" id="price">
    <div class="wrap">
      <div class="price-head">
        <div class="sec-head"><p class="eyebrow">{d.pricing.eyebrow}</p><h2>{d.pricing.title}</h2></div>
        <div class="seg" role="group" aria-label={d.pricing.eyebrow}>
          <button type="button" data-period="monthly" aria-pressed="true">{d.pricing.monthly}</button>
          <button type="button" data-period="yearly" aria-pressed="false">{d.pricing.yearly}<em>{d.pricing.save}</em></button>
        </div>
      </div>
      <div class="card calc" id="calc" hidden>
        <div class="calc-pick">
          <label for="calc-n"><b>{d.pricing.calc.title}</b><span>{d.pricing.calc.hint}</span></label>
          <div class="calc-track" id="calc-track">
            <output id="calc-out" for="calc-n"></output>
            <input type="range" id="calc-n" min="0" step="1" />
          </div>
          <div class="calc-ticks" id="calc-ticks" aria-hidden="true"></div>
        </div>
        <div class="calc-res" aria-live="polite">
          <p class="fine">{d.pricing.calc.best}</p>
          <p class="calc-plan"><span id="calc-plan"></span><em id="calc-cheapest">{d.pricing.calc.cheapest}</em></p>
          <p class="price"><span class="amt" id="calc-amt"></span><span class="per" id="calc-per">{d.pricing.perMonth}</span></p>
          <p class="calc-detail" id="calc-detail"></p>
          <p class="fine" id="calc-alt"></p>
          <a class="btn btn-primary btn-sm" id="calc-cta" href="#"></a>
        </div>
      </div>
      <div class="plans">
        {(['free', 'studio', 'company'] as const).map(id => (
          <article class={id === 'studio' ? 'card plan featured' : 'card plan'} data-plan={id}>
            {id === 'studio' && <p class="plan-flag">{d.pricing.flag}</p>}
            <h3>{d.plans[id]}</h3>
            <p class="plan-for">{d.pricing.for[id]}</p>
            <p class="price"><span class="amt" data-amt></span><span class="per" data-per></span></p>
            <p class="plan-meta" data-perenv></p>
            <p class="plan-note" data-note></p>
            <p class="plan-fit" data-fit hidden></p>
            <a class={id === 'studio' ? 'btn btn-primary full' : 'btn btn-secondary full'} data-cta
              href={id === 'free' ? link(lang, 'signup/') : id === 'studio' ? link(lang, 'checkout/?plan=studio&trial=1') : link(lang, 'contact-sales/')}>{d.pricing.cta[id]}</a>
            {id !== 'free' && <a class="buy" data-buy href={link(lang, `checkout/?plan=${id}&period=monthly`)}>{d.pricing.buy}</a>}
            <ul class="feat">{d.pricing.features[id].map(f => <li><Icon name="check" size={12} />{f}</li>)}</ul>
          </article>
        ))}
      </div>
      <p class="price-foot" data-foot></p>
    </div>
  </section>

  <section class="sec sec-alt" id="faq">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">{d.faq.eyebrow}</p><h2>{d.faq.title}</h2><p class="lead">{d.faq.lead} <a href={link(lang, 'contact-sales/')}>{d.faq.contact}</a></p></div>
      <div class="faq">{d.faq.items.map(([q, a], i) => <details open={i === 0}><summary>{q}<span class="faq-x"><Icon name="plus" size={14} /></span></summary><p>{a}</p></details>)}</div>
    </div>
  </section>

  <section class="sec" id="start">
    <div class="wrap">
      <div class="band">
        <div><h2>{d.band.title}</h2><p>{d.band.body}</p></div>
        <div class="band-cta">
          <a class="btn btn-primary btn-lg" href={link(lang, 'download/')}><Icon name="windows" />{d.band.windows}</a>
          <a class="btn btn-secondary btn-lg" href={link(lang, 'download/')}><Icon name="apple" />{d.band.mac}</a>
          <p class="mono">{d.band.fine}</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { startPricing } from '../../scripts/pricing';
  startPricing();
</script>
