---
// Contacting the team (v2): what the question is about (choosing one sets the form's type) beside the form, each field
// checked when sent with the reason under it. Once sent, the page says so with the number to refer to it by (v2 18);
// if sending fails it says that instead (v2 19), and going back to try again finds everything as it was written.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import { langPaths, link, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const C = t(lang).contact;
const KINDS = ['product', 'support', 'partner'] as const;
---
<Base lang={lang} path="contact/" title={C.title} description={C.lead}>
  <div data-view="form">
    <PageHero title={C.h1} lead={C.lead} />
    <section class="msec">
      <div class="wrap ct">
        <div class="card ct-kinds" role="radiogroup" aria-labelledby="kinds-t">
          <b id="kinds-t">{C.kind}</b>
          {KINDS.map((k, i) => (
            <button type="button" class="ct-kind" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-kind={k}><b>{C.kinds[k][0]}</b><small>{C.kinds[k][1]}</small></button>
          ))}
        </div>
        <form class="form ct-form" id="form" novalidate>
          <div class="field"><label class="req" for="name">{C.name}</label><input id="name" autocomplete="name" maxlength="100" placeholder={C.namePh} required /></div>
          <div class="field"><label class="req" for="email">{C.email}</label><input id="email" type="email" autocomplete="email" placeholder={C.emailPh} required /></div>
          <div class="field">
            <label class="req" for="kind">{C.kind}</label>
            <select id="kind" required>{KINDS.map(k => <option value={k}>{C.kinds[k][0]}</option>)}</select>
          </div>
          <div class="field">
            <label class="req" for="team">{C.teamSize}</label>
            <select id="team" required><option value="" disabled selected>{C.teamPh}</option>{C.sizes.map(([v, l]) => <option value={v}>{l}</option>)}</select>
          </div>
          <div class="field">
            <label class="req" for="message">{C.message}</label>
            <textarea id="message" maxlength="500" placeholder={C.messagePh} required aria-describedby="count"></textarea>
            <span class="hint ct-count" id="count">0 / 500</span>
          </div>
          <label class="check ct-consent"><input type="checkbox" id="consent" required /><span>{C.consent} <a href={link(lang, 'privacy/')}>{C.privacy}</a></span></label>
          <button class="btn btn-primary btn-lg full" type="submit">{C.send}</button>
        </form>
      </div>
    </section>
  </div>

  <div data-view="done" hidden>
    <PageHero title={C.done} lead={C.doneLead} />
    <section class="msec">
      <div class="wrap ct-result">
        <span class="ct-ic ok"><Icon name="check" size={48} /></span>
        <p id="number" data-text={C.doneText}></p>
        <div class="cta-row">
          <a class="btn btn-primary btn-lg" href={link(lang)}>{C.home}</a>
          <button class="btn btn-secondary btn-lg" type="button" id="again">{C.again}</button>
        </div>
      </div>
    </section>
  </div>

  <div data-view="failed" hidden>
    <PageHero title={C.failedTitle} lead={C.failedLead} />
    <section class="msec">
      <div class="wrap ct-result">
        <span class="ct-ic bad"><Icon name="alert" size={48} /></span>
        <p>{C.failedText}</p>
        <div class="cta-row">
          <button class="btn btn-primary btn-lg" type="button" id="retry">{C.retry}</button>
          <a class="btn btn-secondary btn-lg" href={link(lang, 'help/')}>{C.help}</a>
        </div>
      </div>
    </section>
  </div>
</Base>
<style>
  /* v2: the kinds in a 420-wide card on the left, the form in one column on the right */
  .ct{display:grid;grid-template-columns:minmax(0,420px) minmax(0,1fr);gap:60px;align-items:start}
  .ct-kinds{display:grid;gap:8px;padding:20px 12px 12px}
  .ct-kinds > b{padding:0 12px 8px;font-size:16px;line-height:24px}
  .ct-kind{display:grid;gap:4px;padding:14px 12px;border:0;border-radius:var(--r);background:none;text-align:left;font:inherit;color:inherit;cursor:pointer}
  .ct-kind:hover{background:var(--panel)}
  .ct-kind b{font-size:20px;font-weight:600;line-height:28px}
  .ct-kind small{font-size:16px;line-height:28px;color:var(--ink-3)}
  .ct-kind[aria-checked="true"]{background:var(--accent-soft)}
  .ct-kind[aria-checked="true"] b{color:var(--accent-ink)}
  .ct-form{gap:24px}
  .ct-count{justify-self:end}
  .ct-consent a{color:var(--action)}
  /* the result (v2): its icon, what happened 20/32, and where to go next */
  .ct-result{display:grid;justify-items:start}
  .ct-ic.ok{color:var(--good-ink)}
  .ct-ic.bad{color:var(--bad-ink)}
  .ct-result > p{margin-top:28px;font-size:20px;line-height:32px;color:var(--ink-3)}
  .ct-result .cta-row{margin-top:48px}
  [data-view] > :global(.msec:last-child){padding-bottom:88px}
  @media (max-width:900px){.ct{grid-template-columns:minmax(0,1fr);gap:32px}}
</style>
<script>
  import { api, type Inquiry } from '../../lib/api';
  import { $, busy, emailProblem, invalid, lang, d } from '../../scripts/session';
  const C = d.contact, form = $<HTMLFormElement>('form');
  const name = $<HTMLInputElement>('name'), email = $<HTMLInputElement>('email'), team = $<HTMLSelectElement>('team');
  const kind = $<HTMLSelectElement>('kind'), message = $<HTMLTextAreaElement>('message'), consent = $<HTMLInputElement>('consent');
  // The cards and the type field are one choice.
  const cards = document.querySelectorAll<HTMLButtonElement>('[data-kind]');
  const pick = (k: string) => { kind.value = k; cards.forEach(c => c.setAttribute('aria-checked', String(c.dataset.kind === k))); };
  cards.forEach(c => c.addEventListener('click', () => { pick(c.dataset.kind!); kind.focus(); }));
  kind.addEventListener('change', () => pick(kind.value));
  message.addEventListener('input', () => { $('count').textContent = `${message.value.length} / 500`; });
  // One view at a time: the form, sent, or not sent; the page starts over at its title.
  const show = (view: string) => {
    document.querySelectorAll<HTMLElement>('[data-view]').forEach(v => { v.hidden = v.dataset.view !== view; });
    scrollTo({ top: 0 });
    const h = document.querySelector<HTMLElement>(`[data-view="${view}"] h1`)!;
    h.tabIndex = -1;
    h.focus({ preventScroll: true });
  };
  // Checked when sent: each field's reason under it, the first such field focused.
  form.addEventListener('submit', async ev => {
    ev.preventDefault();
    if (invalid([
      [name, name.value.trim() ? '' : C.nameMissing], [email, emailProblem(email)], [team, team.value ? '' : C.teamMissing],
      [message, message.value.trim() ? '' : C.messageMissing], [consent, consent.checked ? '' : C.consentMissing]
    ])) return;
    const send = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    busy(send, true);
    try {
      const { number } = await api<Inquiry>('POST', '/sales-inquiries', {
        kind: kind.value, name: name.value.trim(), email: email.value.trim(), teamSize: team.value, message: message.value.trim(), locale: lang
      });
      $('number').textContent = $('number').dataset.text!.replace('{n}', `#${String(number).padStart(6, '0')}`);
      show('done');
    } catch {
      show('failed');
    } finally {
      busy(send, false);
    }
  });
  $('again').addEventListener('click', () => { form.reset(); message.dispatchEvent(new Event('input')); pick('product'); show('form'); });
  $('retry').addEventListener('click', () => { show('form'); form.querySelector<HTMLButtonElement>('button[type="submit"]')!.focus(); });
</script>
