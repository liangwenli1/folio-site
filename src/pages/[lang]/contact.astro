---
// Contacting the team: what the question is about (choosing one sets the form's type), the form, and once it is sent
// the number to refer to it by; a failure keeps what was written. Below, where else to look.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../lib/icons';
import { langPaths, link, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const C = t(lang).contact;
const KINDS: ['product' | 'support' | 'partner', IconName][] = [['product', 'chat'], ['support', 'help'], ['partner', 'team']];
const MORE: [IconName, string][] = [['book', 'help/'], ['billing', 'pricing/'], ['download', 'download/']];
---
<Base lang={lang} path="contact/" title={C.title} description={C.lead}>
  <section class="wrap page">
    <div class="ct-head"><p class="eyebrow">{C.title}</p><h1>{C.h1}</h1><p class="lead">{C.lead}</p></div>
    <div class="ct">
      <div class="ct-kinds" role="radiogroup" aria-label={C.kind}>
        {KINDS.map(([k, icon], i) => (
          <button type="button" class="card ct-kind" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-kind={k}>
            <span class="tile acc"><Icon name={icon} size={20} /></span>
            <span><b>{C.kinds[k][0]}</b><small>{C.kinds[k][1]}</small></span>
            <Icon name="chevr" />
          </button>
        ))}
      </div>
      <div class="card ct-form">
        <div class="ct-done" id="done" hidden>
          <span class="ct-ok"><Icon name="check" size={22} /></span>
          <h2>{C.done}</h2>
          <p>{C.doneText}</p>
          <p class="ct-number" id="number" data-label={C.number}></p>
          <button class="btn btn-secondary" type="button" id="again">{C.again}</button>
        </div>
        <form class="form" id="form" novalidate>
          <div><h2>{C.formTitle}</h2><p class="ct-sub">{C.formLead}</p></div>
          <div class="notice error" id="err" role="alert" hidden></div>
          <div class="field-row">
            <div class="field"><label for="name">{C.name}<i class="req" aria-hidden="true">*</i></label><input id="name" autocomplete="name" maxlength="100" placeholder={C.namePh} required /></div>
            <div class="field"><label for="email">{C.email}<i class="req" aria-hidden="true">*</i></label><input id="email" type="email" autocomplete="email" placeholder={C.emailPh} required /></div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="kind">{C.kind}<i class="req" aria-hidden="true">*</i></label>
              <select id="kind" required>{KINDS.map(([k]) => <option value={k}>{C.kinds[k][0]}</option>)}</select>
            </div>
            <div class="field">
              <label for="team">{C.teamSize}<i class="req" aria-hidden="true">*</i></label>
              <select id="team" required><option value="" disabled selected>{C.teamPh}</option>{C.sizes.map(([v, l]) => <option value={v}>{l}</option>)}</select>
            </div>
          </div>
          <div class="field">
            <label for="message">{C.message}<i class="req" aria-hidden="true">*</i></label>
            <textarea id="message" maxlength="500" placeholder={C.messagePh} required aria-describedby="count"></textarea>
            <span class="hint ct-count" id="count">0 / 500</span>
          </div>
          <label class="ct-consent"><input type="checkbox" id="consent" required />{C.consent} <a href={link(lang, 'privacy/')}>{C.privacy}</a></label>
          <button class="btn btn-primary btn-lg full" type="submit">{C.send}</button>
        </form>
      </div>
    </div>
  </section>
  <section class="msec alt">
    <div class="wrap">
      <div class="ct-more-head"><p class="eyebrow">{C.more.eyebrow}</p><h2>{C.more.title}</h2><p>{C.more.lead}</p></div>
      <div class="grid-3">
        {C.more.items.map(([title, body], i) => <a class="card ct-link" href={link(lang, MORE[i][1])}><span class="tile"><Icon name={MORE[i][0]} size={20} /></span><span><b>{title}</b><small>{body}</small></span><Icon name="chevr" /></a>)}
      </div>
    </div>
  </section>
</Base>
<style>
  .ct-head{max-width:720px;margin-bottom:36px}
  .ct-head .eyebrow{color:var(--accent-ink)}
  .ct-head h1{font-size:clamp(2rem,4.4vw,3.25rem);line-height:1.15}
  .ct-head .lead{margin-top:14px;font-size:16px}
  .ct{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:24px;align-items:start}
  .ct-kinds{display:grid;gap:14px}
  .ct-kind{display:flex;align-items:center;gap:14px;padding:20px;text-align:left;font:inherit;color:inherit;cursor:pointer}
  .ct-kind > span:nth-child(2){flex:1;display:grid;gap:4px}
  .ct-kind b{font-size:16px}
  .ct-kind small{font-size:13.5px;line-height:1.6;color:var(--ink-2)}
  .ct-kind > :global(.i){color:var(--ink-3)}
  .ct-kind[aria-checked="true"]{border-color:color-mix(in srgb,var(--accent) 45%,var(--line));background:color-mix(in srgb,var(--accent-soft) 55%,var(--card))}
  .ct-kind[aria-checked="true"] > :global(.i){color:var(--accent)}
  .ct-form{padding:28px 30px}
  .ct-form h2{font-size:22px}
  .ct-sub{margin-top:6px;font-size:14px;color:var(--ink-2)}
  .req{margin-left:3px;font-style:normal;color:var(--bad)}
  .ct-count{justify-self:end}
  .ct-consent{display:flex;align-items:center;gap:8px;font-size:14px;color:var(--ink-2)}
  .ct-consent input{width:16px;height:16px;margin:0;accent-color:var(--accent)}
  .ct-consent a{color:var(--accent-ink)}
  .ct-done{display:grid;justify-items:center;gap:10px;padding:24px 8px;text-align:center}
  .ct-ok{display:grid;place-items:center;width:52px;height:52px;border-radius:50%;background:var(--good-soft);color:var(--good)}
  .ct-done p{color:var(--ink-2)}
  .ct-number{font:600 18px var(--f-data);color:var(--ink)!important}
  .ct-done .btn{margin-top:8px}
  .ct-more-head{max-width:720px;margin-bottom:28px}
  .ct-more-head .eyebrow{color:var(--accent-ink)}
  .ct-more-head h2{font-size:clamp(1.5rem,2.6vw,2rem)}
  .ct-more-head p{margin-top:8px;color:var(--ink-2)}
  .ct-link{display:flex;align-items:center;gap:14px;padding:20px;text-decoration:none;color:inherit}
  .ct-link > span:nth-child(2){flex:1;display:grid;gap:4px}
  .ct-link small{font-size:13.5px;line-height:1.6;color:var(--ink-2)}
  .ct-link > :global(.i){color:var(--ink-3)}
  .ct-link:hover{border-color:color-mix(in srgb,var(--accent) 40%,var(--line))}
  @media (max-width:900px){.ct{grid-template-columns:minmax(0,1fr)}}
</style>
<script>
  import { api, type Inquiry } from '../../lib/api';
  import { $, busy, d, lang, showError } from '../../scripts/session';
  const form = $<HTMLFormElement>('form'), err = $('err');
  const kind = $<HTMLSelectElement>('kind'), message = $<HTMLTextAreaElement>('message');
  // The cards and the type field are one choice.
  const cards = document.querySelectorAll<HTMLButtonElement>('[data-kind]');
  const pick = (k: string) => { kind.value = k; cards.forEach(c => c.setAttribute('aria-checked', String(c.dataset.kind === k))); };
  cards.forEach(c => c.addEventListener('click', () => { pick(c.dataset.kind!); kind.focus(); }));
  kind.addEventListener('change', () => pick(kind.value));
  message.addEventListener('input', () => { $('count').textContent = `${message.value.length} / 500`; });
  // Checked when sent: the first field that is missing something takes the focus, and nothing written is lost.
  form.addEventListener('submit', async ev => {
    ev.preventDefault();
    err.hidden = true;
    const missing = ['name', 'email', 'team', 'message', 'consent'].map(id => $<HTMLInputElement>(id))
      .find(f => (f.type === 'checkbox' ? !f.checked : !f.value.trim() || !f.checkValidity()));
    if (missing){ showError(err, d.errors.validation); missing.focus(); return; }
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    busy(btn, true);
    try {
      const { number } = await api<Inquiry>('POST', '/sales-inquiries', {
        kind: kind.value, name: $<HTMLInputElement>('name').value.trim(), email: $<HTMLInputElement>('email').value.trim(),
        teamSize: $<HTMLSelectElement>('team').value, message: message.value.trim(), locale: lang
      });
      $('number').textContent = `${$('number').dataset.label} #${String(number).padStart(6, '0')}`;
      form.hidden = true;
      $('done').hidden = false;
    } catch {
      showError(err, d.contact.failed);
    } finally { busy(btn, false); }
  });
  $('again').addEventListener('click', () => { form.reset(); message.dispatchEvent(new Event('input')); pick('product'); form.hidden = false; $('done').hidden = true; });
</script>
