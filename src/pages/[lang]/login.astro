---
// Logging in: email and password (each checked on submit, the reason under the field), whether to stay signed in after
// the browser closes, and the ways to a forgotten password or a new account. Afterwards it goes where the visitor was
// headed (?next=), or to the account.
import AuthPage from '../../layouts/AuthPage.astro';
import Password from '../../components/Password.astro';
import { langPaths, link, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const A = t(lang).auth;
---
<AuthPage lang={lang} path="login/" title={A.loginTitle}>
  <div class="page-head"><h1>{A.loginTitle}</h1><p>{A.loginLead}</p></div>
  <form class="form" id="form" novalidate>
    <div class="notice error" id="err" role="alert" hidden></div>
    <div class="field"><label for="email">{A.email}</label><input id="email" name="email" type="email" autocomplete="email" placeholder={A.emailPh} required /></div>
    <div class="field"><label for="password">{A.password}</label><Password lang={lang} id="password" autocomplete="current-password" /></div>
    <div class="auth-row">
      <label class="check"><input type="checkbox" id="remember" />{A.remember}</label>
      <a href={link(lang, 'forgot/')}>{A.forgot}</a>
    </div>
    <button class="btn btn-primary btn-lg full" type="submit">{A.login}</button>
  </form>
  <p class="alt">{A.noAccount} <a id="to-signup" href={link(lang, 'signup/')}>{A.toSignup}</a></p>
</AuthPage>
<script>
  import { api } from '../../lib/api';
  import { $, d, emailProblem, invalid, nextPath, onSubmit, param, to, withNext } from '../../scripts/session';
  const email = $<HTMLInputElement>('email'), password = $<HTMLInputElement>('password');
  $<HTMLAnchorElement>('to-signup').href = withNext(to('signup/'));
  if (param('email')) email.value = param('email')!;
  onSubmit($<HTMLFormElement>('form'), $('err'), async () => {
    if (invalid([[email, emailProblem(email)], [password, password.value ? '' : d.errors.passwordMissing]])) return;
    await api('POST', '/auth/login', {
      email: email.value.trim(), password: password.value,
      client: 'web', remember: $<HTMLInputElement>('remember').checked
    });
    location.assign(nextPath() ?? to('account/'));
  });
</script>
