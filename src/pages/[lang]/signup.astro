---
// Signing up: the email, a code sent to it (a minute between codes), a password, and agreeing to the terms and the
// privacy policy (they open in a new tab, so nothing typed is lost). The account it makes is already verified. An
// invitation fills in the email (?email=), and ?next= is where it goes afterwards. A test server without email
// verification asks for no code. Each field is checked on submit, the reason under it; so is an address that already
// has an account, or a wrong code.
import AuthPage from '../../layouts/AuthPage.astro';
import Password from '../../components/Password.astro';
import { langPaths, link, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const A = t(lang).auth;
---
<AuthPage lang={lang} path="signup/" title={A.signupTitle}>
  <div class="page-head"><h1>{A.signupTitle}</h1><p>{A.signupLead}</p></div>
  <form class="form" id="form" novalidate>
    <div class="notice error" id="err" role="alert" hidden></div>
    <div class="notice ok" id="sent" role="status" hidden>{A.codeSent}</div>
    <div class="field"><label for="email">{A.email}</label><input id="email" name="email" type="email" autocomplete="email" placeholder={A.emailPh} required /></div>
    <div class="field" id="code-field">
      <label for="code">{A.code}</label>
      <div class="code-row">
        <input id="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder={A.codePh} required />
        <button class="btn btn-secondary" type="button" id="get">{A.getCode}</button>
      </div>
    </div>
    <div class="field">
      <label for="password">{A.setPassword}</label>
      <Password lang={lang} id="password" autocomplete="new-password" minlength={8} placeholder={A.passwordPh} />
      <span class="hint">{A.passwordHint}</span>
    </div>
    <label class="check"><input type="checkbox" id="consent" required /><span>{A.consent[0]} <a href={link(lang, 'terms/')} target="_blank">{A.consent[1]}</a> {A.consent[2]} <a href={link(lang, 'privacy/')} target="_blank">{A.consent[3]}</a></span></label>
    <button class="btn btn-primary btn-lg full" type="submit">{A.signup}</button>
  </form>
  <p class="alt">{A.haveAccount} <a id="to-login" href={link(lang, 'login/')}>{A.login}</a></p>
</AuthPage>
<script>
  import { api } from '../../lib/api';
  import { $, busy, cooldown, d, emailProblem, fail, invalid, lang, nextPath, onSubmit, param, to, withNext } from '../../scripts/session';
  const err = $('err'), email = $<HTMLInputElement>('email'), code = $<HTMLInputElement>('code');
  const password = $<HTMLInputElement>('password'), consent = $<HTMLInputElement>('consent');
  $<HTMLAnchorElement>('to-login').href = withNext(to('login/'));
  if (param('email')) email.value = param('email')!;
  let needCode = true;
  api<{ emailVerification: boolean }>('GET', '/auth/options').then(o => { needCode = o.emailVerification; $('code-field').hidden = !needCode; }).catch(() => {});
  const address = () => email.value.trim();

  $('get').addEventListener('click', async () => {
    const get = $<HTMLButtonElement>('get');
    err.hidden = true;
    if (invalid([[email, emailProblem(email)]])) return;
    busy(get, true);
    try {
      await api('POST', '/auth/signup-code', { email: address(), locale: lang });
      $('sent').hidden = false;
      busy(get, false);
      cooldown(get, d.auth.resendIn);
      code.focus();
    } catch (e){
      busy(get, false);
      fail(err, e);
    }
  });

  onSubmit($<HTMLFormElement>('form'), err, async () => {
    if (invalid([
      [email, emailProblem(email)],
      [code, !needCode || /^\d{6}$/.test(code.value.trim()) ? '' : d.errors.codeMissing],
      [password, password.value.length >= 8 && password.value.length <= 64 ? '' : d.errors.passwordShort],
      [consent, consent.checked ? '' : d.errors.consentMissing]
    ])) return;
    await api('POST', '/auth/register', { email: address(), code: needCode ? code.value.trim() : undefined, password: password.value, locale: lang });
    location.assign(nextPath() ?? to('account/'));
  });
</script>
