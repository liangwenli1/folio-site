---
// Signing up: an email and a password, and agreeing to the terms and the privacy policy (they open in a new tab, so
// nothing typed is lost); the emailed code comes next, on the verify page. An invitation fills in the email (?email=),
// and ?next= is kept for afterwards.
import AuthPage from '../../layouts/AuthPage.astro';
import Password from '../../components/Password.astro';
import { langPaths, link, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const A = t(lang).auth;
---
<AuthPage lang={lang} path="signup/" title={A.signupTitle}>
  <div class="page-head"><h1>{A.signupTitle}</h1><p>{A.signupLead}</p></div>
  <form class="form" id="form" novalidate>
    <div class="notice error" id="err" role="alert" hidden></div>
    <div class="field"><label for="email">{A.email}</label><input id="email" name="email" type="email" autocomplete="email" placeholder={A.emailPh} required /></div>
    <div class="field">
      <label for="password">{A.setPassword}</label>
      <Password lang={lang} id="password" autocomplete="new-password" minlength={8} />
      <span class="hint">{A.passwordHint}</span>
    </div>
    <label class="check"><input type="checkbox" id="consent" required /><span>{A.consent[0]} <a href={link(lang, 'terms/')} target="_blank">{A.consent[1]}</a> {A.consent[2]} <a href={link(lang, 'privacy/')} target="_blank">{A.consent[3]}</a></span></label>
    <button class="btn btn-primary btn-lg full" type="submit">{A.signup}</button>
  </form>
  <p class="alt">{A.haveAccount} <a id="to-login" href={link(lang, 'login/')}>{A.login}</a></p>
</AuthPage>
<script>
  import { api } from '../../lib/api';
  import { $, d, lang, nextPath, onSubmit, param, to, withNext } from '../../scripts/session';
  $<HTMLAnchorElement>('to-login').href = withNext(to('login/'));
  if (param('email')) $<HTMLInputElement>('email').value = param('email')!;
  onSubmit($<HTMLFormElement>('form'), $('err'), async () => {
    const email = $<HTMLInputElement>('email').value.trim(), password = $<HTMLInputElement>('password').value;
    if (!email) throw d.errors.emailMissing;
    if (password.length < 8) throw d.errors.passwordShort;
    if (!$<HTMLInputElement>('consent').checked){ $('consent').focus(); throw d.errors.consentMissing; }
    const { user } = await api<{ user: { emailVerified: boolean } }>('POST', '/auth/register', { email, password, locale: lang });
    // A test server can skip email verification; then there is no code to enter.
    location.assign(user.emailVerified ? nextPath() ?? to('account/') : withNext(to('verify/')));
  });
</script>
