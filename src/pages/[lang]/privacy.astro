---
// The privacy policy, still a draft: what Folio keeps and why, how it is protected, who else sees it, what you can do
// about it and how to reach us. Items not settled yet say so. The contents beside it follow the reading (and fold on a
// phone).
import Base from '../../layouts/Base.astro';
import Contents from '../../components/Contents.astro';
import Icon from '../../components/Icon.astro';
import { langPaths, link, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const L = t(lang).legal, P = L.privacy;
---
<Base lang={lang} path="privacy/" title={P.title} description={P.sections[0].lead}>
  <section class="lg-hero">
    <div class="wrap"><h1 class="hero-title">{P.title}</h1><p class="lg-draft"><Icon name="info" />{P.draft}</p></div>
  </section>
  <Contents lang={lang} sections={P.sections.map((s): [string, string] => [s.id, s.title])}>
    {P.sections.map((s, i) => (
      <section class="card lg-sec" id={s.id} aria-labelledby={`${s.id}-h`}>
        <h2 id={`${s.id}-h`}><span class="lg-n">{i + 1}</span>{s.title}</h2>
        <p class="lg-lead">{s.lead}</p>
        {s.table && (
          <table class="lg-table">
            <thead><tr>{s.table.head.map(h => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>{s.table.rows.map(([label, ...cells]) => <tr><th scope="row">{label}</th>{cells.map((c, k) => <td data-h={s.table.head[k + 1]}>{c}</td>)}</tr>)}</tbody>
          </table>
        )}
        {s.items && (
          <ul class="lg-list">
            {s.items.map(([label, text, href]) => (
              <li><b>{label}</b>{text === null ? <span class="tbc">{L.tbc}</span> : href ? <a href={link(lang, href)}>{text}</a> : <span>{text}</span>}</li>
            ))}
          </ul>
        )}
      </section>
    ))}
    <p class="lg-meta"><Icon name="doc" /><span>{P.version}<span class="tbc">{L.tbc}</span></span><span>{P.effective}<span class="tbc">{L.tbc}</span></span></p>
  </Contents>
</Base>
<style>
  .lg-hero{padding-block:52px 44px;background:var(--panel);border-bottom:1px solid var(--line)}
  .lg-draft{display:flex;gap:10px;max-width:720px;margin-top:22px;padding:13px 16px;border-radius:var(--r-card);background:var(--seg);font-size:14px;line-height:1.7;color:var(--ink-2)}
  .lg-draft :global(.i){flex:none;margin-top:4px;color:var(--ink-3)}
  .lg-sec{padding:22px 24px 24px}
  .lg-sec h2{display:flex;align-items:center;gap:12px;font-size:20px;line-height:1.35}
  .lg-n{display:grid;place-items:center;width:28px;height:28px;flex:none;border-radius:50%;background:var(--accent);color:var(--on-accent);font:600 14px var(--f-data)}
  /* the text itself is long-form: 16 / 1.8, at most 720 wide */
  .lg-lead{max-width:720px;margin:8px 0 16px 40px;font-size:16px;line-height:1.8;color:var(--ink-2)}
  .lg-table{width:100%;border-collapse:separate;border-spacing:0;border:1px solid var(--line);border-radius:var(--r-card);overflow:hidden;font-size:16px;line-height:1.8}
  .lg-table :is(th,td){padding:11px 16px;border-top:1px solid var(--line);text-align:left;vertical-align:top}
  .lg-table thead th{border-top:0;background:var(--panel);font-size:14px;font-weight:600;color:var(--ink-2)}
  .lg-table tbody th{width:150px;font-weight:600;color:var(--ink)}
  .lg-table td{color:var(--ink-2)}
  .lg-table :is(th,td) + :is(th,td){border-left:1px solid var(--line)}
  .lg-list{display:grid;gap:10px;margin:0;padding:16px 20px;border-radius:var(--r-card);background:var(--panel);list-style:none;font-size:16px;line-height:1.8;color:var(--ink-2)}
  .lg-list li{position:relative;padding-left:18px}
  .lg-list li::before{content:'';position:absolute;left:2px;top:.72em;width:6px;height:6px;border-radius:50%;background:var(--accent)}
  .lg-list b{font-weight:600;color:var(--ink)}
  .lg-list b::after{content:'：'}
  html[lang="en"] .lg-list b{margin-right:6px}
  html[lang="en"] .lg-list b::after{content:':'}
  .lg-list a{color:var(--accent-ink)}
  .lg-list b + .tbc{margin-left:0}
  .lg-meta{display:flex;flex-wrap:wrap;align-items:center;gap:8px 20px;padding:14px 20px;border-radius:var(--r-card);background:var(--panel);font-size:14px;color:var(--ink-2)}
  .lg-meta :global(.i){color:var(--ink-3)}
  @media (max-width:700px){
    .lg-sec{padding:18px 16px 20px}
    .lg-lead{margin-left:0}
    .lg-table thead{display:none}
    .lg-table :is(tr,th,td){display:block}
    .lg-table tr + tr{border-top:1px solid var(--line)}
    .lg-table :is(th,td){padding:4px 14px;border:0!important}
    .lg-table tbody th{width:auto;padding-top:12px}
    .lg-table tr td:last-child{padding-bottom:12px}
    .lg-table td::before{content:attr(data-h);display:block;font-size:12px;font-weight:600;color:var(--ink-3)}
  }
</style>
