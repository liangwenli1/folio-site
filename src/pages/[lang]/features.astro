---
// What Folio does, area by area (v2): the blocks alternate sides, each with its number, what it is for, three things it
// does and a way to try it, beside that page of the real workbench.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import Shot from '../../components/Shot.astro';
import type { IconName } from '../../lib/icons';
import { langPaths, link, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang), F = d.features;
// Each block: its anchor, the icons of its three points, and the picture (zoomed towards what it is about).
const BLOCKS: { id: string; points: IconName[]; shot: string; zoom: number; origin: string }[] = [
  { id: 'profiles', points: ['dice', 'engines', 'layers'], shot: 'new', zoom: 1.22, origin: '55% 12%' },
  { id: 'proxies', points: ['link', 'search', 'swap'], shot: 'proxies', zoom: 1.2, origin: '100% 0' },
  { id: 'team', points: ['folder', 'user', 'doc'], shot: 'groups', zoom: 1.2, origin: '100% 0' },
  { id: 'engines', points: ['layers', 'download', 'check'], shot: 'engines', zoom: 1.2, origin: '100% 0' },
  { id: 'automation', points: ['windows', 'clock', 'code'], shot: 'sync', zoom: 1.2, origin: '100% 0' }
];
---
<Base lang={lang} path="features/" title={F.title} description={F.lead}>
  <PageHero title={F.h1} lead={F.lead} />

  {BLOCKS.map((b, i) => {
    const B = F.blocks[i];
    return (
      <section class:list={['fblock', { flip: i % 2 === 1 }]} id={b.id} aria-labelledby={`${b.id}-h`}>
        <div class="wrap cols fblock-in">
          <div class="fblock-copy">
            <p class="fnum">{String(i + 1).padStart(2, '0')}</p>
            <h2 id={`${b.id}-h`}>{B.title}</h2>
            <p class="fblock-lead">{B.lead}</p>
            <ul class="fpts">
              {B.points.map(([title, body], k) => <li><Icon name={b.points[k]} size={20} /><div><b>{title}</b><p>{body}</p></div></li>)}
            </ul>
            <a class="btn btn-secondary btn-lg" href={link(lang, 'signup/')}>{d.nav.start}</a>
          </div>
          <Shot lang={lang} name={b.shot} alt={B.shot} zoom={b.zoom} origin={b.origin} />
        </div>
      </section>
    );
  })}
</Base>
<style>
  /* v2: each block's copy and picture side by side, the sides swapping from one block to the next; on the page grid the
     copy takes 5 columns and the picture 7 */
  .fblock{padding-block:40px}
  :global(.phero) + .fblock{padding-top:32px}
  .fblock:last-child{padding-bottom:88px}
  .fblock-in{align-items:center}
  @media (min-width:961px){
    .fblock-copy{grid-column:span 5}
    .fblock-in > :global(.shot){grid-column:span 7}
    .flip .fblock-copy{grid-column:8 / span 5;grid-row:1}
    .flip .fblock-in > :global(.shot){grid-column:1 / span 7;grid-row:1}
  }
  .fnum{font-size:14px;font-weight:600;line-height:22px;color:var(--action)}
  .fblock h2{margin-top:16px;font-size:clamp(1.75rem,3vw,2.25rem);line-height:1.333}
  .fblock-lead{margin-top:16px;font-size:18px;line-height:30px;color:var(--ink-3)}
  .fpts{display:grid;gap:18px;margin:28px 0 32px;padding:0;list-style:none}
  .fpts li{display:flex;gap:12px}
  .fpts li > :global(.i){margin-top:2px;color:var(--action)}
  .fpts b{font-size:16px;font-weight:600;line-height:24px}
  .fpts p{margin-top:2px;font-size:14px;line-height:22px;color:var(--ink-3)}
  @media (max-width:960px){.fblock-in{row-gap:32px}}
</style>
