---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import '../../styles/app.css';
import { langPaths, link, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang);
const c = d.checkout;
---
<Base lang={lang} path="checkout/" title={c.title} noindex>
  <section class="wrap page co">
    <div class="co-head"><h1>{c.title}</h1><span class="tag" id="current"></span></div>
    <ol class="steps" id="steps">
      {c.steps.map((label, i) => <li data-step={i + 1}><i><span>{i + 1}</span><Icon name="check" size={11} /></i>{label}</li>)}
    </ol>
    <div class="notice error" id="err" role="alert" hidden></div>
    <div class="notice" id="no-manage" hidden>{c.noManage}</div>
    <div class="panel done" id="done" hidden>
      <span class="tile"><Icon name="check" size={20} /></span>
      <p id="done-text"></p>
      <a class="btn btn-primary" href={link(lang, 'account/')}>{c.toAccount}</a>
    </div>
    <div class="co-body" id="co" hidden>
      <div class="panel co-plan" id="step-plan">
        <div class="field" id="ws-field" hidden>
          <label for="ws">{c.workspace}</label>
          <select id="ws"></select>
        </div>
        <fieldset class="opts">
          <legend>{c.plan}</legend>
          {(['studio', 'company'] as const).map(id => (
            <label class="opt"><input type="radio" name="plan" value={id} /><span><b>{d.plans[id]}</b><small data-size={id}></small></span><span class="opt-price" data-price={id}></span></label>
          ))}
        </fieldset>
        <div class="co-two">
          <fieldset class="opts">
            <legend>{c.billing}</legend>
            <div class="seg" role="group">
              <button type="button" data-period="monthly" aria-pressed="true">{d.pricing.monthly}</button>
              <button type="button" data-period="yearly" aria-pressed="false">{d.pricing.yearly}<em>{d.pricing.save}</em></button>
            </div>
          </fieldset>
          <div class="opts">
            <p class="legend" id="packs-label">{c.packs}</p>
            <div class="row">
              <div class="stepper" role="group" aria-labelledby="packs-label">
                <button type="button" id="packs-minus" aria-label="−">−</button>
                <output id="packs">0</output>
                <button type="button" id="packs-plus" aria-label="+">+</button>
              </div>
              <span class="fine" id="packs-hint">{c.packsHint}</span>
            </div>
          </div>
        </div>
        <button class="btn btn-primary btn-lg full" type="button" id="next">{c.next}</button>
      </div>

      <div class="co-pay" id="step-pay" hidden>
        <div class="panel chosen">
          <div><p class="panel-t">{c.chosen}</p><b id="chosen"></b><small id="chosen-meta"></small></div>
          <button class="linkish" type="button" id="edit">{c.edit}</button>
        </div>
        <form class="panel form" id="card-form" novalidate>
          <div class="form" id="card-fields">
            <p class="panel-t">{c.card}</p>
            <div class="field"><label for="number">{c.cardNumber}</label><input id="number" inputmode="numeric" autocomplete="cc-number" placeholder="4242 4242 4242 4242" required /></div>
            <div class="field-row">
              <div class="field"><label for="exp">{c.expiry}</label><input id="exp" inputmode="numeric" autocomplete="cc-exp" placeholder="12/30" required /></div>
              <div class="field"><label for="cvc">{c.cvc}</label><input id="cvc" inputmode="numeric" autocomplete="cc-csc" maxlength="4" placeholder="123" required /></div>
            </div>
            <div class="field"><label for="name">{c.name}</label><input id="name" autocomplete="cc-name" /></div>
          </div>
          <ul class="lines" id="lines"></ul>
          <p class="total"><span>{c.total}</span><b id="total">–</b></p>
          <p class="fine" id="effect"></p>
          <p class="notice" id="soon" hidden>{c.soon}</p>
          <button class="btn btn-primary btn-lg full" type="submit" id="pay" disabled>{c.confirm}</button>
          <p class="mock" id="mock"><Icon name="alert" size={13} /><span><b>{c.mockTitle}</b> · {c.mockBody}</span></p>
        </form>
      </div>

      <div class="trial" id="trial-box" hidden>
        <Icon name="clock" />
        <span>{c.trial}</span>
        <button class="btn btn-secondary btn-sm" type="button" id="trial-btn">{c.trialCta}</button>
      </div>
    </div>
  </section>
</Base>
<script>
  import { api, canManage, type CheckoutStarted, type Paid, type Plans, type Quote, type Workspace } from '../../lib/api';
  import { lineLabel, money } from '../../lib/format';
  import { $, busy, d, here, lang, param, requireMe, showError, to, withNext } from '../../scripts/session';

  type PlanId = 'studio' | 'company'; type Period = 'monthly' | 'yearly';
  const c = d.checkout;
  const me = await requireMe();
  if (!me.user.emailVerified) location.replace(withNext(to('verify/'), here()));
  const managed = me.workspaces.filter(w => canManage(w.role));
  if (!managed.length){ $('no-manage').hidden = false; throw new Error('no managed workspace'); }

  const plans = await api<Plans>('GET', '/plans');
  const planOf = (id: PlanId) => plans.plans.find(p => p.id === id)!;
  const perMonth = (id: PlanId, period: Period) => (period === 'monthly' ? planOf(id).price.monthly : Math.round(planOf(id).price.yearly / 12));
  let ws: Workspace;
  const sel = {
    plan: (param('plan') === 'company' ? 'company' : 'studio') as PlanId,
    period: (param('period') === 'yearly' ? 'yearly' : 'monthly') as Period,
    // The pricing calculator links here with the add-on packs it worked out.
    packs: Math.max(0, Number.parseInt(param('packs') ?? '', 10) || 0)
  };
  let quote: Quote | null = null;

  // Choose a plan, pay, done. A link that already names a plan (pricing, calculator) starts at paying, unless it is
  // the free trial's.
  function step(n: 1 | 2 | 3){
    document.querySelectorAll<HTMLElement>('#steps li').forEach(li => {
      const i = Number(li.dataset.step);
      li.classList.toggle('done', i < n || n === 3);
      li.classList.toggle('now', i === n && n !== 3);
    });
    $('step-plan').hidden = n !== 1;
    $('step-pay').hidden = n !== 2;
    $('co').hidden = n === 3;
    $('done').hidden = n !== 3;
    scrollTo({ top: 0 });
  }

  const select = $<HTMLSelectElement>('ws');
  select.innerHTML = managed.map(w => `<option value="${w.id}">${w.name.replace(/</g, '&lt;')} · ${d.plans[w.plan]}</option>`).join('');
  select.value = managed.some(w => w.id === param('ws')) ? param('ws')! : managed[0].id;
  $('ws-field').hidden = managed.length < 2;

  async function loadWorkspace(){
    ws = await api<Workspace>('GET', `/workspaces/${select.value}`);
    const s = ws.subscription;
    const paid = s.status === 'active' && s.plan !== 'free';
    if (paid){
      if (!param('plan')) sel.plan = s.plan as PlanId;
      if (!param('period')) sel.period = s.period as Period;
      if (!param('packs')) sel.packs = s.addonPacks;
    }
    $('current').textContent = (s.status === 'trialing' ? c.currentTrial : c.current)(d.plans[s.plan]);
    $('trial-box').hidden = !s.trialAvailable;
    $('trial-box').classList.toggle('highlight', param('trial') === '1');
    render();
  }

  function render(){
    document.querySelectorAll<HTMLInputElement>('input[name="plan"]').forEach(i => { i.checked = i.value === sel.plan; });
    document.querySelectorAll('[data-period]').forEach(b => b.setAttribute('aria-pressed', String(b.getAttribute('data-period') === sel.period)));
    (['studio', 'company'] as PlanId[]).forEach(id => {
      const p = planOf(id);
      document.querySelector(`[data-size="${id}"]`)!.textContent = d.pricing.profilesMembers(p.profiles, p.members === 1 ? d.pricing.oneMember : d.pricing.unlimitedMembers);
      document.querySelector(`[data-price="${id}"]`)!.textContent = `${money(perMonth(id, sel.period), lang)} ${d.pricing.perMonth}`;
    });
    const base = planOf(sel.plan).profiles, profiles = base + sel.packs * plans.addon.profiles;
    $('packs').textContent = String(sel.packs);
    $<HTMLButtonElement>('packs-minus').disabled = sel.packs === 0;
    $<HTMLButtonElement>('packs-plus').disabled = base + (sel.packs + 1) * plans.addon.profiles > plans.maxProfiles;
    $('packs-hint').textContent = `${c.packsHint} · ${d.pricing.calc.profiles(profiles)}`;
    $('chosen').textContent = `${sel.packs ? d.pricing.calc.withPacks(d.plans[sel.plan], sel.packs) : d.plans[sel.plan]} · ${d.periods[sel.period]}`;
    $('chosen-meta').textContent = `${ws.name} · ${d.pricing.calc.profiles(profiles)}`;
    requote();
  }

  let seq = 0;
  async function requote(){
    const mine = ++seq;
    $('err').hidden = true;
    $<HTMLButtonElement>('pay').disabled = true;
    try {
      const q = await api<Quote>('POST', `/workspaces/${ws.id}/billing/quote`, { plan: sel.plan, period: sel.period, addonPacks: sel.packs });
      if (mine !== seq) return;
      quote = q;
      $('lines').innerHTML = '';
      for (const l of q.lines){
        const li = document.createElement('li');
        if (l.kind === 'credit') li.className = 'credit';
        li.innerHTML = '<span></span><span></span>';
        li.children[0].textContent = lineLabel(d, l);
        li.children[1].textContent = money(l.amountCents, lang);
        $('lines').append(li);
      }
      $('total').textContent = money(q.totalCents, lang);
      $('effect').textContent = c.change[q.change];
      const needsCard = q.totalCents > 0;
      // Until payments open, only changes that cost nothing go through.
      const soon = needsCard && !plans.payments;
      $('soon').hidden = !soon;
      $('card-fields').hidden = $('mock').hidden = !needsCard || soon;
      $('pay').textContent = soon ? c.soonPay : needsCard ? c.pay(money(q.totalCents, lang)) : c.confirm;
      $<HTMLButtonElement>('pay').disabled = soon;
    } catch (e){
      if (mine !== seq) return;
      quote = null;
      $('lines').innerHTML = ''; $('total').textContent = '–'; $('effect').textContent = '';
      showError($('err'), e);
    }
  }

  function finish(text: string){
    $('done-text').textContent = text;
    step(3);
  }

  document.querySelectorAll<HTMLInputElement>('input[name="plan"]').forEach(i => i.addEventListener('change', () => { sel.plan = i.value as PlanId; render(); }));
  document.querySelectorAll<HTMLButtonElement>('[data-period]').forEach(b => b.addEventListener('click', () => { sel.period = b.dataset.period as Period; render(); }));
  $('packs-minus').addEventListener('click', () => { sel.packs = Math.max(0, sel.packs - 1); render(); });
  $('packs-plus').addEventListener('click', () => { sel.packs += 1; render(); });
  select.addEventListener('change', () => loadWorkspace().catch(e => showError($('err'), e)));
  $('next').addEventListener('click', () => step(2));
  $('edit').addEventListener('click', () => step(1));

  $('trial-btn').addEventListener('click', async () => {
    try { await api('POST', `/workspaces/${ws.id}/billing/trial`); finish(c.trialStarted); }
    catch (e){ showError($('err'), e); }
  });

  $('card-form').addEventListener('submit', async ev => {
    ev.preventDefault();
    if (!quote) return;
    $('err').hidden = true;
    const btn = $<HTMLButtonElement>('pay'); busy(btn, true);
    try {
      const started = await api<CheckoutStarted>('POST', `/workspaces/${ws.id}/billing/checkout`, { plan: sel.plan, period: sel.period, addonPacks: sel.packs });
      if (!started.checkoutId) return finish(c.applied);
      const [mm, yy] = $<HTMLInputElement>('exp').value.split('/').map(s => s.trim());
      const card = { number: $<HTMLInputElement>('number').value, expMonth: Number(mm), expYear: 2000 + Number(yy), cvc: $<HTMLInputElement>('cvc').value.trim() };
      await api<Paid>('POST', `/billing/checkouts/${started.checkoutId}/pay`, { card });
      finish(c.success);
    } catch (e){
      showError($('err'), e);
    } finally { busy(btn, false); }
  });

  await loadWorkspace();
  step(param('plan') && param('trial') !== '1' ? 2 : 1);
</script>
