---
import Base from '../../layouts/Base.astro';
import '../../styles/app.css';
import { langPaths, link, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang);
const i = d.invoice;
---
<Base lang={lang} path="invoice/" title={i.title} noindex>
  <section class="wrap page">
    <div class="row no-print" style="margin-bottom:20px">
      <a class="quiet" href={link(lang, 'account/')}>← {i.back}</a>
      <span class="spacer"></span>
      <button class="btn btn-ghost" type="button" id="print">{i.print}</button>
    </div>
    <div class="notice error" id="err" role="alert" hidden></div>
    <article class="invoice" id="invoice" hidden>
      <header>
        <div>
          <a class="brand" href={link(lang)}><span class="seal" aria-hidden="true">F</span><span class="brand-word">{i.seller}</span></a>
          <p class="fine" style="margin-top:8px">{i.sellerNote}</p>
        </div>
        <h1>{i.title}</h1>
      </header>
      <div class="refunded" id="refunded" hidden></div>
      <dl class="meta">
        <div><dt>{i.number}</dt><dd id="number"></dd></div>
        <div><dt>{i.date}</dt><dd id="date"></dd></div>
        <div><dt>{i.billedTo}</dt><dd id="billed"></dd></div>
        <div><dt>{i.workspace}</dt><dd id="ws"></dd></div>
        <div><dt>{i.period}</dt><dd id="period"></dd></div>
      </dl>
      <table class="list">
        <thead><tr><th scope="col">{i.item}</th><th scope="col" style="text-align:right">{i.amount}</th></tr></thead>
        <tbody id="lines"></tbody>
        <tfoot><tr><th scope="row">{i.total}</th><td class="mono" style="text-align:right;font-weight:600" id="total"></td></tr></tfoot>
      </table>
      <p class="fine" id="paid-with" style="margin-top:18px"></p>
    </article>
  </section>
</Base>
<script>
  import { api, type Invoice } from '../../lib/api';
  import { day, lineLabel, money } from '../../lib/format';
  import { $, d, lang, param, requireMe, showError } from '../../scripts/session';

  const i = d.invoice;
  $('print').addEventListener('click', () => print());
  try {
    await requireMe();
    const { payment: p, workspace, billedTo } = await api<Invoice>('GET', `/payments/${encodeURIComponent(param('id') ?? '')}`);
    $('number').textContent = p.invoiceNumber;
    $('date').textContent = day(p.createdAt, lang);
    $('billed').textContent = billedTo;
    $('ws').textContent = workspace.name;
    $('period').textContent = p.periodStart && p.periodEnd ? `${day(p.periodStart, lang)} – ${day(p.periodEnd, lang)}` : '–';
    for (const l of p.lines){
      const tr = document.createElement('tr');
      tr.innerHTML = '<td></td><td class="mono" style="text-align:right"></td>';
      tr.children[0].textContent = lineLabel(d, l);
      tr.children[1].textContent = money(l.amountCents, lang);
      $('lines').append(tr);
    }
    $('total').textContent = money(p.amountCents, lang);
    if (p.cardBrand && p.cardLast4) $('paid-with').textContent = i.paidWith(p.cardBrand.toUpperCase(), p.cardLast4);
    if (p.refundedAt){ $('refunded').textContent = i.refunded(day(p.refundedAt, lang)); $('refunded').hidden = false; }
    $('invoice').hidden = false;
  } catch (e){
    showError($('err'), e);
  }
</script>
