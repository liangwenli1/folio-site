---
import Base from '../../layouts/Base.astro';
import Mark from '../../components/Mark.astro';
import Icon from '../../components/Icon.astro';
import '../../styles/app.css';
import { langPaths, link, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const d = t(lang);
const i = d.invoice;
---
<Base lang={lang} path="invoice/" title={i.title} noindex>
  <section class="wrap page in">
    <div class="row no-print in-bar">
      <a class="quiet row" href={link(lang, 'account/')}><Icon name="back" />{i.back}</a>
      <span class="spacer"></span>
      <button class="btn btn-secondary" type="button" id="print"><Icon name="download" />{i.print}</button>
    </div>
    <div class="notice error" id="err" role="alert" hidden></div>
    <article class="panel in-doc" id="invoice" hidden>
      <header class="in-hd">
        <a class="brand" href={link(lang)}><Mark /><span class="brand-word">{i.seller}</span></a>
        <div class="in-no"><h1>{i.title}</h1><span class="fine">{i.number} <span class="mono" id="number"></span></span><span class="tag" id="refunded" hidden></span></div>
      </header>
      <dl class="in-meta">
        <div><dt>{i.date}</dt><dd id="date"></dd></div>
        <div><dt>{i.billedTo}</dt><dd id="billed"></dd></div>
        <div><dt>{i.workspace}</dt><dd id="ws"></dd></div>
        <div><dt>{i.period}</dt><dd id="period"></dd></div>
      </dl>
      <table class="list in-lines">
        <thead><tr><th scope="col">{i.item}</th><th scope="col" class="num">{i.amount}</th></tr></thead>
        <tbody id="lines"></tbody>
      </table>
      <p class="in-sum"><span>{i.total}</span><b class="mono" id="total"></b></p>
      <p class="fine in-paid" id="paid-with"></p>
      <p class="fine in-note">{i.sellerNote}</p>
    </article>
  </section>
</Base>
<script>
  import { api, type Invoice } from '../../lib/api';
  import { day, lineLabel, money } from '../../lib/format';
  import { $, d, lang, param, requireMe, showError } from '../../scripts/session';

  const i = d.invoice;
  $('print').addEventListener('click', () => print());
  try {
    await requireMe();
    const { payment: p, workspace, billedTo } = await api<Invoice>('GET', `/payments/${encodeURIComponent(param('id') ?? '')}`);
    $('number').textContent = p.invoiceNumber;
    $('date').textContent = day(p.createdAt, lang);
    $('billed').textContent = billedTo;
    $('ws').textContent = workspace.name;
    $('period').textContent = p.periodStart && p.periodEnd ? `${day(p.periodStart, lang)} – ${day(p.periodEnd, lang)}` : '–';
    for (const l of p.lines){
      const tr = document.createElement('tr');
      tr.innerHTML = '<td></td><td class="mono num"></td>';
      tr.children[0].textContent = lineLabel(d, l);
      tr.children[1].textContent = money(l.amountCents, lang);
      $('lines').append(tr);
    }
    $('total').textContent = money(p.amountCents, lang);
    if (p.cardBrand && p.cardLast4) $('paid-with').textContent = i.paidWith(p.cardBrand.toUpperCase(), p.cardLast4);
    if (p.refundedAt){ $('refunded').textContent = i.refunded(day(p.refundedAt, lang)); $('refunded').hidden = false; }
    $('invoice').hidden = false;
  } catch (e){
    showError($('err'), e);
  }
</script>
