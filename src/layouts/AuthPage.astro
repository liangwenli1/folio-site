---
// Sign-in, sign-up and the email/password steps around them: the form, and beside it the workbench on the brand
// gradient, as on the home page. `points` lists what the account gets (sign-up only).
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import Showcase from '../components/Showcase.astro';
import SampleProfile from '../components/SampleProfile.astro';
import { t, type Lang } from '../lib/i18n';

interface Props { lang: Lang; path: string; title: string; points?: boolean }
const { lang, path, title, points = false } = Astro.props;
const d = t(lang);
---
<Base lang={lang} path={path} title={title} noindex>
  <section class="wrap auth">
    <div class="auth-main">
      <div class="auth-form"><slot /></div>
      {points && <ul class="auth-pts">{d.auth.points.map(p => <li><Icon name="check" size={12} />{p}</li>)}</ul>}
    </div>
    <div class="auth-aside">
      <div class="glow" aria-hidden="true"></div>
      <Showcase lang={lang} label={d.demo.label} pause={d.demo.pause} play={d.demo.play} />
      <SampleProfile lang={lang} />
    </div>
  </section>
</Base>
<script>
  // Show / hide the password: the eye button inside the box switches the field's type.
  document.querySelectorAll<HTMLButtonElement>('.pw button').forEach(b => b.addEventListener('click', () => {
    const input = b.parentElement!.querySelector('input')!;
    const shown = input.type === 'password';
    input.type = shown ? 'text' : 'password';
    b.setAttribute('aria-pressed', String(shown));
  }));
</script>
