---
// The sign-in pages (log in, sign up, verify the email, reset the password), as G1 draws them (PLAN 6.23 1.1), with the
// sides swapped (the user, 10-28): the simple header; on the left the brand panel, as on the workbench's sign-in: three
// browser profiles as the workbench lists them, still, on its gradient; on the right the form. Its own part (the slot,
// from the title to the button) sits level with the middle of the panel, and what follows it hangs below: the way to
// the other page (the "after" slot), then the privacy policy, the terms and the language switch, since these pages have
// no footer. The panel only decorates, so screen readers skip it; below 1100 wide there is only the form.
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { link, t, type Lang } from '../lib/i18n';

interface Props { lang: Lang; path: string; title: string }
const { lang, path, title } = Astro.props;
const d = t(lang);
// Each profile's flag (where it exits), engine and state; the second is restoring its sign-ins, so it has the
// workbench's spinner, standing still. Their names, cities and states are in auth.profiles. The engine logos
// (public/logos, from svgl as in the workbench) are their owners' trademarks, there only to say which engine it is.
const LOOKS = [
  { flag: 'us', engine: 'chromium', version: 'Chromium 150', tone: 'good', icon: 'play', count: '1:42:10' },
  { flag: 'gb', engine: 'firefox', version: 'Firefox 156', tone: 'info', icon: null, count: '3 / 4' },
  { flag: 'jp', engine: 'chromium', version: 'Chromium 150', tone: 'stop', icon: 'pause', count: null }
] as const;
const profiles = d.auth.profiles.map(([name, city, state], i) => ({ name, city, state, ...LOOKS[i] }));
---
<Base lang={lang} path={path} title={title} noindex simple>
  <section class="auth">
    <div class="auth-brand" aria-hidden="true">
      {profiles.map(p => (
        <div class="auth-pc">
          <span class="auth-flag"><img src={`/flags/${p.flag}.svg`} alt="" width="30" height="30" /><span><img src={`/logos/${p.engine}.svg`} alt="" width="12" height="12" /></span></span>
          <span><b>{p.name}</b><small>{p.city} · {p.version}</small></span>
          <span class={`auth-st ${p.tone}`}>{p.icon ? <Icon name={p.icon} /> : <i></i>}{p.state}{p.count && <span class="mono">{p.count}</span>}</span>
        </div>
      ))}
    </div>
    <div class="auth-main">
      <div class="auth-form">
        <div class="auth-core"><slot /></div>
        <div class="auth-tail">
          <slot name="after" />
          <nav class="auth-foot" aria-label={d.footer.legal}>
            <a href={link(lang, 'privacy/')}>{d.footer.privacy}</a>
            <a href={link(lang, 'terms/')}>{d.footer.terms}</a>
            <LangSwitch lang={lang} path={path} />
          </nav>
        </div>
      </div>
    </div>
  </section>
</Base>
