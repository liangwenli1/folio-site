---
// A guide or the API reference: the guides by category on the left (with a search that narrows them and this page's
// headings, in the browser), the breadcrumb and the page in the middle, the page's headings on the right.
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import { CATEGORIES, inCategory } from '../lib/help';
import { link, t, type Lang } from '../lib/i18n';

interface Props { lang: Lang; path: string; title: string; description?: string; crumbs: [string, string | null][]; toc: [string, string][] }
const { lang, path, title, description, crumbs, toc } = Astro.props;
const d = t(lang), H = d.help;
const here = (p: string) => (p === path ? 'page' : undefined);
---
<Base lang={lang} path={path} title={title} description={description}>
  <section class="wrap help-grid">
    <nav class="help-nav" aria-label={H.title}>
      <label class="help-search"><Icon name="search" size={14} /><input type="search" placeholder={H.searchDocs} aria-label={H.searchDocs} data-doc-search /></label>
      {CATEGORIES.map(c => (
        <section data-group>
          <b>{H.categories[c.id].title}</b>
          {inCategory(d, c.id).map(s => <a class="help-item" href={link(lang, `help/${s}/`)} aria-current={here(`help/${s}/`)} data-item>{H.articles[s].title}</a>)}
        </section>
      ))}
      <section data-group><b>{H.developers}</b><a class="help-item" href={link(lang, 'help/api/')} aria-current={here('help/api/')} data-item>{H.apiLink}</a></section>
    </nav>
    <article class="help-page">
      <nav class="crumbs" aria-label={d.nav.crumbs}>
        {crumbs.map(([label, href], i) => <>{i > 0 && <span aria-hidden="true">/</span>}{href ? <a href={href}>{label}</a> : <span aria-current="page">{label}</span>}</>)}
      </nav>
      <slot />
    </article>
    <aside class="help-toc" aria-label={H.toc}><b>{H.toc}</b>{toc.map(([id, label]) => <a href={`#${id}`} data-item>{label}</a>)}</aside>
  </section>
</Base>
<script>
  // The search narrows the guides and this page's headings to what matches; groups with nothing left are hidden.
  const box = document.querySelector<HTMLInputElement>('[data-doc-search]')!;
  box.addEventListener('input', () => {
    const q = box.value.trim().toLowerCase();
    document.querySelectorAll<HTMLElement>('[data-item]').forEach(el => { el.hidden = !!q && !el.textContent!.toLowerCase().includes(q); });
    document.querySelectorAll<HTMLElement>('[data-group], .help-toc').forEach(g => { g.hidden = !!q && !g.querySelector('[data-item]:not([hidden])'); });
  });
</script>
<style>
  .help-grid{display:grid;grid-template-columns:230px minmax(0,1fr) 190px;gap:48px;align-items:start;padding-block:36px 96px}
  .help-nav{position:sticky;top:calc(var(--hd) + 24px);display:grid;gap:18px;font-size:14px}
  .help-search{display:flex;align-items:center;gap:8px;height:var(--h-ctl);padding:0 12px;border:1px solid var(--line-2);border-radius:var(--r);background:var(--card);color:var(--ink-3)}
  .help-search input{flex:1;min-width:0;border:0;background:none;font:inherit;font-size:14px;color:var(--ink);outline:none}
  .help-search:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
  .help-nav section{display:grid;gap:2px}
  .help-nav b{margin-bottom:6px;font-size:13px;color:var(--ink)}
  .help-item{padding:7px 10px;border-radius:var(--r);color:var(--ink-2);text-decoration:none}
  .help-item:hover{background:var(--panel);color:var(--ink)}
  .help-item[aria-current="page"]{background:var(--accent-soft);color:var(--accent-ink);font-weight:600;box-shadow:inset 3px 0 0 var(--accent)}
  .help-page{min-width:0;max-width:780px}
  .help-page .crumbs{margin-bottom:16px}
  .help-toc{position:sticky;top:calc(var(--hd) + 24px);display:grid;gap:8px;padding-left:16px;border-left:1px solid var(--line);font-size:13px}
  .help-toc b{margin-bottom:4px;font-size:13px}
  .help-toc a{color:var(--ink-2);text-decoration:none}
  .help-toc a:hover{color:var(--accent-ink)}
  .help-page :global(h1){font-size:clamp(1.75rem,3.4vw,2.25rem);line-height:1.25}
  .help-page :global(h2){scroll-margin-top:calc(var(--hd) + 16px)}
  @media (max-width:1100px){.help-grid{grid-template-columns:210px minmax(0,1fr)}.help-toc{display:none}}
  @media (max-width:760px){.help-grid{grid-template-columns:minmax(0,1fr);gap:32px;padding-block:28px 72px}.help-nav{position:static;order:2}}
</style>
