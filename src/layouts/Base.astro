---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Lang } from '../lib/i18n';

interface Props { lang: Lang; path: string; title?: string; description?: string; noindex?: boolean }
const { lang, path, title, description, noindex = false } = Astro.props;
const d = t(lang);
const fonts = lang === 'zh'
  ? 'family=Bodoni+Moda:opsz,wght@6..96,700&family=Martian+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@600;900'
  : 'family=Bodoni+Moda:ital,opsz,wght@0,6..96,600..800;1,6..96,600..800&family=Martian+Mono:wght@400;500&family=Schibsted+Grotesk:wght@400..700';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title ? `${title} · Folio` : d.meta.title}</title>
    <meta name="description" content={description ?? d.meta.description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang="en" href={`/en/${path}`} />
    <link rel="alternate" hreflang="zh" href={`/zh/${path}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} />
  </head>
  <body>
    <Header lang={lang} path={path} />
    <main><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
