---
import '@fontsource-variable/manrope/wght.css';
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Lang } from '../lib/i18n';

interface Props { lang: Lang; path: string; title?: string; description?: string; noindex?: boolean }
const { lang, path, title, description, noindex = false } = Astro.props;
const d = t(lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title ? `${title} · Folio` : d.meta.title}</title>
    <meta name="description" content={description ?? d.meta.description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang="en" href={`/en/${path}`} />
    <link rel="alternate" hreflang="zh" href={`/zh/${path}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <Header lang={lang} />
    <main><slot /></main>
    <Footer lang={lang} path={path} />
  </body>
</html>
