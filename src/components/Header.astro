---
import Mark from './Mark.astro';
import { link, t, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<header class="top">
  <div class="wrap top-in">
    <a class="brand" href={link(lang)} aria-label="Folio"><Mark /><span class="brand-word">Folio</span></a>
    <nav class="nav" aria-label={d.nav.menu}>
      <a href={`${link(lang)}#who`}>{d.nav.who}</a>
      <a href={`${link(lang)}#inside`}>{d.nav.inside}</a>
      <a href={`${link(lang)}#team`}>{d.nav.teams}</a>
      <a href={`${link(lang)}#auto`}>{d.nav.automation}</a>
      <a href={`${link(lang)}#price`}>{d.nav.pricing}</a>
      <a href={`${link(lang)}#faq`}>{d.nav.faq}</a>
    </nav>
    <div class="top-act">
      <span class="row" data-auth="out">
        <a class="quiet" href={link(lang, 'login/')}>{d.nav.login}</a>
        <a class="btn btn-primary btn-sm" href={link(lang, 'signup/')}>{d.nav.start}</a>
      </span>
      <span data-auth="in" hidden><a class="btn btn-secondary btn-sm" href={link(lang, 'account/')}>{d.nav.account}</a></span>
    </div>
  </div>
</header>
<script>
  import { api } from '../lib/api';
  api('GET', '/me').then(() => {
    document.querySelectorAll('[data-auth="out"]').forEach(e => e.setAttribute('hidden', ''));
    document.querySelectorAll('[data-auth="in"]').forEach(e => e.removeAttribute('hidden'));
  }).catch(() => {});
  // Over the home page's gradient the header stays clear until the page scrolls (global.css .over-hero).
  if (document.documentElement.classList.contains('over-hero')){
    const scrolled = () => document.documentElement.classList.toggle('scrolled', scrollY > 8);
    scrolled();
    addEventListener('scroll', scrolled, { passive: true });
  }
</script>
