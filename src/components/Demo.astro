---
// The product demo: the workbench rebuilt in HTML (not a screenshot), playing four scenes in a loop. scripts/demo.ts
// drives it; the replica itself is decoration for screen readers, the steps and scene buttons are not.
import '../styles/passport.css';
import '../styles/demo.css';
import Mark from './Mark.astro';
import { t, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang), m = d.demo, a = m.app, card = d.hero.card;

// The same projection as the workbench's exit map (and public/land-dots.svg).
const W = 560, H = 196;
const at = (lon: number, lat: number) => [((lon + 180) / 360) * W, ((76 - lat) / 132) * H].map(v => Math.round(v * 10) / 10);
// The profiles' exits; New York is the one being opened, with a second profile on the same proxy.
const PINS: [string, number, number, string][] = [
  ['sea', -122.3, 47.6, 'run'], ['ny', -74, 40.7, 'idle'], ['ldn', -0.1, 51.5, 'idle'], ['fra', 8.7, 50.1, 'idle'],
  ['sao', -46.6, -23.5, 'idle'], ['tyo', 139.7, 35.7, 'idle'], ['sin', 103.8, 1.35, 'bad']
];
const ROWS: [string, string, string][] = [['US-Store-01', '0001', 'us'], ['US-Store-02', '0002', 'us'], ['US-Store-03', '0003', 'us'], ['UK-Shop-01', '0004', 'gb']];
const ICONS = [
  'M3.5 3h9A1.5 1.5 0 0 1 14 4.5v7a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 11.5v-7A1.5 1.5 0 0 1 3.5 3zM2 6h12',
  'M14 8A6 6 0 1 1 2 8a6 6 0 0 1 12 0zM2 8h12M8 2c2.2 2.2 2.2 9.8 0 12M8 2c-2.2 2.2-2.2 9.8 0 12',
  'M8.5 5.5a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0zM1.5 13c.5-2.5 2.3-3.8 4.5-3.8s4 1.3 4.5 3.8M10.5 3.3a2.3 2.3 0 0 1 0 4.4M12 9.6c1.3.5 2.2 1.6 2.5 3.4',
  'M2.5 5h6a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1h-6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM6.5 5V3.5a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H9.5',
  'M2.5 2.5h4v3h-4zM9.5 10.5h4v3h-4zM4.5 5.5v6.5h5M11.5 10.5V7.5h-4',
  'M4.5 4.5h7v7h-7zM6.5 2v2.5M9.5 2v2.5M6.5 11.5V14M9.5 11.5V14M2 6.5h2.5M2 9.5h2.5M11.5 6.5H14M11.5 9.5H14'
];
const COUNTS = ['9', '6', '3', '', '2', ''];
const check = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5 6.5 11.5l6-7"/></svg>';
---
<section class="sec sec-alt" id="demo">
  <div class="wrap">
    <div class="demo-head">
      <div class="sec-head"><p class="eyebrow">{m.eyebrow}</p><h2>{m.title}</h2></div>
      <button class="btn btn-secondary btn-sm" type="button" id="demo-toggle" data-pause={m.pause} data-play={m.play}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path class="i-pause" d="M5.5 3.5v9M10.5 3.5v9" /><path class="i-play" d="M5.5 3.8v8.4L12 8z" /></svg>
        <span>{m.pause}</span>
      </button>
    </div>
    <div class="demo" id="demo-root" data-scene="1">
      <ol class="demo-steps">
        {m.steps.map(([title, sub], i) => <li class="dstep"><span class="dnum"><b>{i + 1}</b><Fragment set:html={check} /></span><span><b>{title}</b><small>{sub}</small></span></li>)}
      </ol>
      <div class="demo-stage">
        <div class="dapp" aria-hidden="true">
          <div class="dapp-bar"><i></i><i></i><i></i></div>
          <div class="dapp-body">
            <nav class="dapp-side">
              <span class="dapp-brand"><Mark />Folio</span>
              {a.nav.map((label, i) => <span class:list={['dnav', { on: i === 0 }]}><svg viewBox="0 0 16 16"><path d={ICONS[i]} /></svg>{label}{COUNTS[i] && <em>{COUNTS[i]}</em>}</span>)}
            </nav>
            <div class="dapp-main">
              <h4>{a.title}</h4>
              <div class="dmap">
                <div class="dmap-land"></div>
                <svg viewBox={`0 0 ${W} ${H}`}>
                  {PINS.map(([key, lon, lat, state], i) => {
                    const [x, y] = at(lon, lat);
                    return <g class={`dpin ${state} on`} data-pin={key} style={`--i:${i}`} transform={`translate(${x} ${y})`}><circle class="ring" r="12" /><circle class="halo" r="11" /><circle class="dot" r="4" /></g>;
                  })}
                </svg>
                <span class="dtip" style={`--x:${at(-74, 40.7)[0] / W};--y:${at(-74, 40.7)[1] / H}`}>{a.tip}</span>
              </div>
              <div class="drisk"><svg viewBox="0 0 16 16"><path d="M8 4.5v4.5M8 11.5v.01" /></svg>{a.risk}</div>
              <div class="drows">
                {ROWS.map(([name, no, cc], i) => (
                  <div class:list={['drow', `r${i + 1}`]} data-state={i === 0 ? 'run' : 'idle'}>
                    <img class="dflag" src={`/flags/${cc}.svg`} alt="" width="22" height="22" loading="lazy" />
                    <span class="dname"><b>{name}</b><small>#{no}</small></span>
                    <span class="dcity"><i></i>{a.cities[i]}</span>
                    <span class="dstatus">
                      <span class="st idle">{a.idle}</span>
                      <span class="st run"><i></i>{a.run}</span>
                      {i === 1 && <span class="st boot" data-stages={JSON.stringify(a.stage)}><span class="segs"><i></i><i></i><i></i><i></i></span><span class="stage">{a.stage[0]}</span></span>}
                    </span>
                  </div>
                ))}
              </div>
            </div>
            <div class="dapp-detail">
              <article class="idcard dcard">
                <header class="id-head"><span>FOLIO</span><span class="id-no">No. <b>0002</b></span></header>
                <div class="id-city"><span class="city">{a.cities[1]}</span></div>
                <dl class="id-fields">
                  <div class="wide"><dt>{card.exitIp}</dt><dd>71.190.•••.••</dd></div>
                  <div class="wide"><dt>{card.tz}</dt><dd>America/New_York</dd></div>
                  <div><dt>{card.os}</dt><dd>Windows 11</dd></div>
                  <div><dt>{card.engine}</dt><dd>Chromium 150</dd></div>
                </dl>
                <div class="stamp dstamp"><span class="s-top">FOLIO</span><span class="s-main">{card.stamp}</span></div>
              </article>
              <ul class="dconsistent">{a.consistent.map(c => <li><Fragment set:html={check} />{c}</li>)}</ul>
              <div class="dreport">
                <p class="dreport-h">{a.report}</p>
                <ul>{a.checks.map(c => <li class="dcheck"><span class="dtick"><Fragment set:html={check} /></span>{c}</li>)}</ul>
                <div class="stamp dpassed"><span class="s-top">FOLIO</span><span class="s-main">{d.inside.passed}</span></div>
              </div>
            </div>
          </div>
        </div>
        <div class="demo-scenes" role="group" aria-label={m.scenesLabel}>
          {m.scenes.map((s, i) => <button type="button" data-go={i + 1} aria-pressed={i === 0 ? 'true' : 'false'}><b>{i + 1}</b>{s}</button>)}
          <span class="fine">{m.loop}</span>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  import { startDemo } from '../scripts/demo';
  startDemo();
</script>
