---
// The site's footer: the brand and what Folio is, the product, resources and company links, and the language switch.
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import { link, otherLang, t, type Lang } from '../lib/i18n';

interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const d = t(lang);
const f = d.footer, n = d.nav;
const other = otherLang(lang);
// The switch names the language the page is in; clicking it opens the same page in the other one.
const names: Record<Lang, string> = { en: 'English', zh: '简体中文' };
const cols: [string, [string, string][]][] = [
  [f.product, [[n.features, 'features/'], [n.solutions, 'solutions/'], [n.pricing, 'pricing/'], [n.download, 'download/']]],
  [f.resources, [[n.help, 'help/'], [f.api, 'help/api/'], [f.changelog, 'changelog/']]],
  [f.company, [[f.contact, 'contact/'], [f.privacy, 'privacy/'], [f.terms, 'terms/']]]
];
---
<footer class="foot">
  <div class="wrap">
    <div class="foot-in">
      <div class="foot-brand">
        <a class="brand" href={link(lang)} aria-label="Folio"><Mark /><span class="brand-word">Folio</span></a>
        <b>{f.tagline}</b>
        <p>{f.about}</p>
      </div>
      {cols.map(([title, links]) => (
        <nav class="foot-col" aria-label={title}><b>{title}</b>{links.map(([label, p]) => <a href={link(lang, p)}>{label}</a>)}</nav>
      ))}
    </div>
    <div class="foot-end">
      <p>{f.rights}</p>
      <a class="lang-switch" href={`/${other}/${path}`} hreflang={other} title={other === 'zh' ? 'Switch to Chinese' : 'Switch to English'} data-lang-switch><Icon name="globe" size={14} />{names[lang]}</a>
    </div>
  </div>
</footer>
<script>
  // Keep the query string when switching language, so checkout and invoice links survive.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach(a => {
    a.addEventListener('click', () => { a.href = a.href.split(/[?#]/)[0] + location.search + location.hash; });
  });
</script>
<style>
  .foot{padding:56px 0 28px;background:var(--panel);border-top:1px solid var(--line)}
  .foot-in{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:40px}
  .foot-brand{display:grid;gap:10px;align-content:start}
  .foot-brand b{margin-top:6px;font-size:14px}
  .foot-brand p{max-width:340px;font-size:13.5px;line-height:1.75;color:var(--ink-2)}
  .foot-col{display:grid;gap:10px;align-content:start;font-size:14px}
  .foot-col b{margin-bottom:4px;font-size:13.5px;color:var(--ink)}
  .foot-col a{text-decoration:none;color:var(--ink-2)}
  .foot-col a:hover{color:var(--ink)}
  .foot-end{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px;margin-top:44px;padding-top:20px;border-top:1px solid var(--line);font-size:13px;color:var(--ink-3)}
  .lang-switch{display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border:1px solid var(--line-2);border-radius:99px;background:var(--card);text-decoration:none;color:var(--ink-2)}
  .lang-switch:hover{color:var(--ink);border-color:var(--ink-3)}
  @media (max-width:860px){.foot-in{grid-template-columns:repeat(3,minmax(0,1fr));gap:32px 20px}.foot-brand{grid-column:1/-1}}
</style>
