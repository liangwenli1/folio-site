---
// The site's footer (v2): the brand and its line, the product, resources and legal links, the copyright, and the
// language switch.
import Mark from './Mark.astro';
import LangSwitch from './LangSwitch.astro';
import { link, t, type Lang } from '../lib/i18n';

interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const d = t(lang);
const f = d.footer, n = d.nav;
const cols: [string, [string, string][]][] = [
  [f.product, [[n.features, 'features/'], [n.solutions, 'solutions/'], [n.pricing, 'pricing/'], [n.download, 'download/']]],
  [f.resources, [[n.help, 'help/'], [f.api, 'help/api/'], [f.changelog, 'changelog/'], [f.contact, 'contact/']]],
  [f.legal, [[f.privacy, 'privacy/'], [f.terms, 'terms/']]]
];
---
<footer class="foot">
  <div class="wrap foot-in">
    <div class="foot-brand">
      <a class="brand" href={link(lang)} aria-label="Folio"><Mark /><span class="brand-word">Folio</span></a>
      <p>{f.tagline}</p>
    </div>
    {cols.map(([title, links]) => (
      <nav class="foot-col" aria-label={title}><b>{title}</b>{links.map(([label, p]) => <a href={link(lang, p)}>{label}</a>)}</nav>
    ))}
    <div class="foot-end"><p>{f.rights}</p><LangSwitch lang={lang} path={path} /></div>
  </div>
</footer>
<style>
  /* v2: the page grey, the brand on the left and the three link columns 244 apart on the right */
  .foot{padding:28px 0 32px;background:var(--bg)}
  @media (prefers-color-scheme: dark){.foot{background:var(--panel);border-top:1px solid var(--line)}}
  .foot-in{display:grid;grid-template-columns:minmax(0,1fr) repeat(3,minmax(0,244px));gap:28px 0}
  .foot-brand{display:grid;gap:20px;align-content:start}
  .foot-brand :global(.seal){width:22px;height:22px}
  .foot-brand .brand-word{font-size:18px}
  .foot-brand p{font-size:14px;color:var(--ink-3)}
  .foot-col{display:grid;gap:8px;align-content:start;padding-top:4px;font-size:14px}
  .foot-col b{margin-bottom:6px;font-weight:600;color:var(--ink)}
  .foot-col a{text-decoration:none;color:var(--ink-3)}
  .foot-col a:hover{color:var(--ink)}
  .foot-end{grid-column:1 / -1;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px;font-size:12px;color:var(--ink-3)}
  @media (max-width:860px){.foot-in{grid-template-columns:repeat(3,minmax(0,1fr))}.foot-brand,.foot-end{grid-column:1 / -1}}
  @media (max-width:520px){.foot-in{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
