---
import { link, t, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).footer;
---
<footer class="foot">
  <div class="wrap foot-in">
    <a class="brand" href={link(lang)} aria-label="Folio"><span class="seal" aria-hidden="true">F</span><span class="brand-word">Folio</span></a>
    <nav aria-label="Footer">
      <a href={link(lang, 'docs/')}>{d.docs}</a>
      <a href={link(lang, 'docs/api/')}>{d.api}</a>
      <a href={link(lang, 'changelog/')}>{d.changelog}</a>
      <a href={link(lang, 'contact-sales/')}>{d.sales}</a>
      <a href={link(lang, 'privacy/')}>{d.privacy}</a>
      <a href={link(lang, 'terms/')}>{d.terms}</a>
    </nav>
    <p class="fine">{d.rights}</p>
  </div>
</footer>
<style>
  .foot{padding-block:40px;border-top:1px solid var(--line)}
  .foot-in{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:20px 40px}
  nav{display:flex;flex-wrap:wrap;gap:8px 22px;font-size:14px;color:var(--ink-2)}
  nav a{text-decoration:none}
  nav a:hover{color:var(--ink)}
  .fine{flex-basis:100%}
</style>
