---
// A profile as a passport data page, stamped ISOLATED. Extra attributes (id, data-*) go on the card.
import '../styles/passport.css';
import { stampDate } from '../lib/format';
import { t, type Lang } from '../lib/i18n';

interface Props { lang: Lang; class?: string; id?: string; 'aria-hidden'?: 'true'; [attr: `data-${string}`]: string }
const { lang, class: cls, ...attrs } = Astro.props;
const h = t(lang).hero;
const first = h.cities[0];
---
<article class:list={['idcard', cls]} {...attrs}>
  <canvas class="gl" data-kind="card" aria-hidden="true"></canvas>
  <header class="id-head"><span>{h.card.title}</span><span class="id-no">No. <b data-f="no">0042</b></span></header>
  <div class="id-city"><span class="city" data-f="city">{first.city}</span><span class="region" data-f="region">{first.region}</span></div>
  <dl class="id-fields">
    <div><dt>{h.card.exitIp}</dt><dd data-f="ip">172.58.•••.••</dd></div>
    <div><dt>{h.card.tz}</dt><dd data-f="tz">America/Los_Angeles</dd></div>
    <div><dt>{h.card.lang}</dt><dd data-f="lang">en-US, en</dd></div>
    <div><dt>{h.card.os}</dt><dd data-f="os">Windows 11</dd></div>
    <div><dt>{h.card.engine}</dt><dd data-f="core">Chromium 150</dd></div>
    <div><dt>{h.card.screen}</dt><dd data-f="res">1920 × 1080</dd></div>
    <div class="wide"><dt>{h.card.gpu}</dt><dd data-f="gpu">Intel Iris Xe Graphics</dd></div>
    <div><dt>{h.card.canvas}</dt><dd data-f="hash">7c2e…a91f</dd></div>
    <div><dt>{h.card.fonts}</dt><dd data-f="fonts">61 {h.card.fontsUnit}</dd></div>
  </dl>
  <div class="mrz" aria-hidden="true"><span data-f="mrz1">FOLIO&lt;ENV0042&lt;&lt;US&lt;SEATTLE&lt;&lt;&lt;&lt;&lt;&lt;&lt;</span><span data-f="mrz2">WIN11&lt;CHR150&lt;1920X1080&lt;&lt;7C2EA91F</span></div>
  <div class="stamp" aria-hidden="true"><span class="s-top">FOLIO</span><span class="s-main">{h.card.stamp}</span><span class="s-date" data-f="date">{stampDate(new Date())}</span></div>
</article>
<script>
  // The stamp carries the visitor's date, not the build's.
  import { stampDate } from '../lib/format';
  document.querySelectorAll('.stamp [data-f="date"]').forEach(el => { el.textContent = stampDate(new Date()); });
</script>
