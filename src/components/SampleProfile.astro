---
// A browser profile card floating over the product picture: its exit country's flag, name, place and status.
import Icon from './Icon.astro';
import { t, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const s = t(Astro.props.lang).demo.sample;
---
<div class="sample" aria-hidden="true">
  <img class="flag" src="/flags/gb.svg" width="40" height="40" alt="" />
  <span class="sample-who"><b>{s.name}</b><small>{s.place}</small></span>
  <span class="chip run"><Icon name="play" size={12} />{s.status}<span class="sub">0:00:03</span></span>
</div>
<style>
  .sample{position:absolute;display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:16px;background:var(--card);box-shadow:0 30px 60px -24px rgba(80,30,50,.5)}
  .flag{width:40px;height:40px;border-radius:50%;object-fit:cover;box-shadow:0 0 0 1px var(--line)}
  .sample-who{display:grid;line-height:1.4}
  .sample-who b{font-size:14px}
  .sample-who small{font-size:12px;color:var(--ink-2)}
</style>
