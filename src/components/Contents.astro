---
// A legal page's body (v2): its contents in a card beside the sections (the slot; each section carries the id its entry
// links to). The contents mark the section being read; on a phone they fold away above the sections, and picking one
// folds them again. The privacy policy and the terms share it.
import Icon from './Icon.astro';
import { t, type Lang } from '../lib/i18n';

interface Props { lang: Lang; sections: [string, string][] }
const { lang, sections } = Astro.props;
const label = t(lang).legal.toc;
---
<div class="wrap lg-grid">
  <details class="card lg-toc" open>
    <summary>{label}<Icon name="chev" /></summary>
    <nav aria-label={label}>{sections.map(([id, title], i) => <a href={`#${id}`} aria-current={i === 0 ? 'true' : undefined}>{title}</a>)}</nav>
  </details>
  <div class="lg-body"><slot /></div>
</div>
<script>
  const toc = document.querySelector<HTMLDetailsElement>('.lg-toc')!;
  const links = [...toc.querySelectorAll<HTMLAnchorElement>('a')];
  const sections = links.map(a => document.getElementById(a.hash.slice(1))!);
  const wide = matchMedia('(min-width: 861px)');
  const fold = () => { toc.open = wide.matches; };
  fold();
  wide.addEventListener('change', fold);
  links.forEach(a => a.addEventListener('click', () => { if (!wide.matches) toc.open = false; }));
  // The section whose top has passed the header; at the end of the page, where the last ones can't scroll up that far,
  // the one picked in the contents if it is in view, else the last.
  const mark = () => {
    const end = innerHeight + scrollY >= document.documentElement.scrollHeight - 4;
    let at = 0;
    sections.forEach((s, i) => { if (s.getBoundingClientRect().top <= 160) at = i; });
    if (end){
      const picked = sections.findIndex(s => `#${s.id}` === location.hash);
      at = picked >= 0 && sections[picked].getBoundingClientRect().top < innerHeight ? picked : sections.length - 1;
    }
    links.forEach((a, i) => { if (i === at) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current'); });
  };
  addEventListener('scroll', mark, { passive: true });
  mark();
</script>
<style>
  /* v2: the contents card 220 wide, the sections 40 to its right */
  .lg-grid{display:grid;grid-template-columns:220px minmax(0,1fr);gap:40px;align-items:start;padding-block:32px 88px}
  .lg-toc{position:sticky;top:calc(var(--hd) + 24px);padding:20px 12px 12px}
  .lg-toc summary{display:block;padding:0 12px 12px;font-size:16px;font-weight:600;line-height:24px;list-style:none;pointer-events:none}
  .lg-toc summary::-webkit-details-marker{display:none}
  .lg-toc summary :global(.i){display:none}
  .lg-toc nav{display:grid;gap:2px}
  .lg-toc a{padding:8px 12px;border-radius:var(--r);font-size:14px;font-weight:500;line-height:22px;color:var(--ink-3);text-decoration:none}
  .lg-toc a:hover{background:var(--panel);color:var(--ink)}
  .lg-toc a[aria-current]{background:var(--accent-soft);color:var(--accent-ink);font-weight:600}
  .lg-body{display:grid;gap:44px;min-width:0}
  @media (max-width:860px){
    .lg-grid{grid-template-columns:minmax(0,1fr);row-gap:20px;padding-top:24px}
    .lg-toc{position:static;padding:0}
    .lg-toc summary{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;cursor:pointer;pointer-events:auto}
    .lg-toc summary :global(.i){display:block}
    .lg-toc summary::-webkit-details-marker{display:none}
    .lg-toc[open] summary :global(.i){rotate:180deg}
    .lg-toc nav{padding:0 8px 8px}
  }
</style>
