---
// The workbench walkthrough beside the home page's first screen and the sign-in forms (PLAN 6.15, part four): pictures
// of the real workbench recorded by folio-desktop's demo/capture.spec.ts (copied to public/demo/), played by
// scripts/demo-player.ts. Only the visitor's language and colour scheme load, the first picture first; it starts at
// the profile list. Where it sits and how big it is comes from the page (index: .hero-vis, sign-in: .auth-aside), which
// positions it (its pause button sits inside).
import type { Lang } from '../lib/i18n';

interface Props { lang: Lang; label: string; pause: string; play: string }
const { lang, label, pause, play } = Astro.props;
---
<figure class="showcase" role="group" aria-label={label} data-lang={lang} data-pause={pause} data-play={play}>
  <picture>
    <source srcset={`/demo/${lang}-dark/list.webp`} media="(prefers-color-scheme: dark)" />
    <img src={`/demo/${lang}-light/list.webp`} width="1920" height="1200" alt="" />
  </picture>
</figure>
<style>
  .showcase{margin:0}
  .showcase img{display:block;width:100%;height:auto;border-radius:12px}
</style>
<script>
  import { mountDemo, type DemoManifest } from '../scripts/demo-player';

  const dark = matchMedia('(prefers-color-scheme: dark)');
  for (const fig of document.querySelectorAll<HTMLElement>('.showcase')){
    const { lang = 'en', pause = '', play = '' } = fig.dataset;
    let stop: (() => void) | null = null;
    const start = async () => {
      const manifest = await (await fetch(`/demo/${lang}.json`)).json() as DemoManifest;
      const set = `${lang}-${dark.matches ? 'dark' : 'light'}`;
      stop?.();
      fig.replaceChildren();
      stop = mountDemo(fig, { manifest, src: file => `/demo/${set}/${file}.webp`, labels: { pause, play } });
    };
    void start();
    dark.addEventListener('change', () => void start());
  }
</script>
