---
// A password box with a show / hide button inside it, which switches the field's type.
import Icon from './Icon.astro';
import { t, type Lang } from '../lib/i18n';

interface Props { lang: Lang; id: string; autocomplete: 'current-password' | 'new-password'; minlength?: number; placeholder?: string }
const { lang, id, autocomplete, minlength, placeholder } = Astro.props;
const show = t(lang).auth.showPassword;
---
<div class="pw">
  <input id={id} name={id} type="password" autocomplete={autocomplete} minlength={minlength} placeholder={placeholder} required />
  <button type="button" aria-label={show} title={show} aria-pressed="false"><Icon name="eye" /></button>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('.pw button').forEach(b => b.addEventListener('click', () => {
    const input = b.parentElement!.querySelector('input')!;
    const shown = input.type === 'password';
    input.type = shown ? 'text' : 'password';
    b.setAttribute('aria-pressed', String(shown));
  }));
</script>
