---
// Questions with their answers (v2): the section's head — the title and a line, which `contact` ends with a link —
// then a card for each.
interface Props { title: string; lead?: string; contact?: { label: string; href: string }; items: [string, string][] }
const { title, lead, contact, items } = Astro.props;
---
<div class="msec-head">
  <h2>{title}</h2>
  {lead && <p>{lead}{contact && <> <a href={contact.href}>{contact.label}</a></>}</p>}
</div>
<div class="faq-list">
  {items.map(([q, a]) => <div class="faq-item"><h3>{q}</h3><p>{a}</p></div>)}
</div>
