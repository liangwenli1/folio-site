---
// Docs, the changelog and the legal pages: the docs' contents on the left (with a search that filters it and this
// page's headings, in the browser), the page in the middle, its headings on the right. `toc` lists those headings.
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { apiSections } from '../lib/docs';
import { link, t, type Lang } from '../lib/i18n';

interface Props { lang: Lang; path: string; title: string; lead?: string; draft?: string; toc?: [string, string][] }
const { lang, path, title, lead, draft, toc = [] } = Astro.props;
const D = t(lang).docs, N = D.nav, L = t(lang).legal;
const guides = [N.start, N.profiles, N.proxies, N.team];
const api = apiSections(t(lang));
const other: [string, string][] = [['changelog/', D.changelogTitle], ['privacy/', L.privacyTitle], ['terms/', L.termsTitle]];
---
<Base lang={lang} path={path} title={title}>
  <section class={toc.length ? 'wrap doc-grid' : 'wrap doc-grid no-toc'}>
    <nav class="doc-nav" aria-label={D.title}>
      <label class="doc-search"><Icon name="search" size={14} /><input type="search" placeholder={D.search} aria-label={D.search} data-doc-search /></label>
      <section data-group><b>{N.guides}</b>{guides.map(g => <span class="doc-item soon" data-item>{g}<small>{D.soon}</small></span>)}</section>
      <section data-group><b>{N.api}</b>{api.map(([id, label]) => <a class="doc-item" href={`${link(lang, 'docs/api/')}#${id}`} data-item>{label}</a>)}</section>
      <section data-group><b>{N.other}</b>{other.map(([p, label]) => <a class:list={['doc-item', { on: p === path }]} href={link(lang, p)} aria-current={p === path ? 'page' : undefined} data-item>{label}</a>)}</section>
    </nav>
    <article class="doc">
      {path !== 'docs/' && <p class="doc-crumb"><a href={link(lang, 'docs/')}>{D.home}</a><Icon name="chevr" size={11} /><span>{title}</span></p>}
      <div class="page-head"><h1>{title}</h1>{lead && <p>{lead}</p>}</div>
      {draft && <p class="notice doc-draft">{draft}</p>}
      <slot />
    </article>
    {toc.length > 0 && (
      <aside class="doc-toc" aria-label={D.toc}><b>{D.toc}</b>{toc.map(([id, label]) => <a href={`#${id}`} data-item>{label}</a>)}</aside>
    )}
  </section>
</Base>
<script>
  // The search narrows the contents and this page's headings to what matches; groups with nothing left are hidden.
  const box = document.querySelector<HTMLInputElement>('[data-doc-search]')!;
  box.addEventListener('input', () => {
    const q = box.value.trim().toLowerCase();
    document.querySelectorAll<HTMLElement>('[data-item]').forEach(el => { el.hidden = !!q && !el.textContent!.toLowerCase().includes(q); });
    document.querySelectorAll<HTMLElement>('[data-group], .doc-toc').forEach(g => { g.hidden = !!q && !g.querySelector('[data-item]:not([hidden])'); });
  });
</script>
<style>
  .doc-grid{display:grid;grid-template-columns:230px minmax(0,1fr) 180px;gap:48px;align-items:start;padding-block:44px 96px}
  .doc-grid.no-toc{grid-template-columns:230px minmax(0,1fr)}
  .doc-nav{position:sticky;top:calc(var(--hd) + 24px);display:grid;gap:18px;font-size:14px}
  .doc-search{display:flex;align-items:center;gap:8px;height:38px;padding:0 12px;border:1px solid var(--line-2);border-radius:10px;background:var(--card);color:var(--ink-3)}
  .doc-search input{flex:1;min-width:0;border:0;background:none;font:inherit;font-size:14px;color:var(--ink);outline:none}
  .doc-search:focus-within{border-color:var(--ink-2);box-shadow:0 0 0 3px var(--seg)}
  .doc-nav section{display:grid;gap:2px}
  .doc-nav b{margin-bottom:6px;font-size:12.5px;color:var(--ink-3)}
  .doc-item{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:7px 10px;border-radius:9px;color:var(--ink-2);text-decoration:none}
  a.doc-item:hover{background:var(--panel);color:var(--ink)}
  .doc-item.on{background:var(--panel);color:var(--ink);font-weight:600;box-shadow:inset 3px 0 0 var(--accent)}
  .doc-item small{font-size:11px;color:var(--ink-3);white-space:nowrap}
  .doc-item.soon{cursor:default}
  .doc{min-width:0;max-width:760px}
  .doc-crumb{display:flex;align-items:center;gap:8px;margin-bottom:18px;font-size:13px;color:var(--ink-3)}
  .doc-crumb a{text-decoration:none}
  .doc-crumb a:hover{color:var(--ink)}
  .doc-draft{margin-bottom:24px}
  .doc :global(h2){margin:40px 0 12px;font-size:22px;line-height:1.3;scroll-margin-top:calc(var(--hd) + 16px)}
  .doc :global(h3){margin:22px 0 8px;font-size:15px}
  .doc :global(p + p){margin-top:14px}
  .doc :global(.doc-body){color:var(--ink-2);line-height:1.8}
  .doc :global(.entries){display:grid;gap:18px;margin:0}
  .doc :global(.entries dt){font-family:var(--f-data);font-size:12.5px;color:var(--ink-3)}
  .doc :global(.entries dd){margin:4px 0 0;color:var(--ink-2);line-height:1.75}
  .doc-toc{position:sticky;top:calc(var(--hd) + 24px);display:grid;gap:8px;font-size:13px}
  .doc-toc b{margin-bottom:4px;font-size:12.5px;color:var(--ink-3)}
  .doc-toc a{color:var(--ink-2);text-decoration:none}
  .doc-toc a:hover{color:var(--ink)}
  @media (max-width:1100px){.doc-grid,.doc-grid.no-toc{grid-template-columns:200px minmax(0,1fr)}.doc-toc{display:none}}
  @media (max-width:760px){.doc-grid,.doc-grid.no-toc{grid-template-columns:minmax(0,1fr);gap:32px;padding-block:32px 72px}.doc-nav{position:static;order:2}}
</style>
