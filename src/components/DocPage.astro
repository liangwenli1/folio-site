---
import Base from '../layouts/Base.astro';
import type { Lang } from '../lib/i18n';

interface Props { lang: Lang; path: string; title: string; lead?: string; draft?: string }
const { lang, path, title, lead, draft } = Astro.props;
---
<Base lang={lang} path={path} title={title}>
  <section class="wrap page">
    <article class="doc">
      <div class="page-head"><h1>{title}</h1>{lead && <p>{lead}</p>}</div>
      {draft && <p class="notice" style="margin-bottom:24px">{draft}</p>}
      <slot />
    </article>
  </section>
</Base>
<style>
  .doc{max-width:720px}
  .doc :global(p + p){margin-top:14px}
  .doc :global(.entries){display:grid;gap:18px;margin:0}
  .doc :global(.entries dt){font-family:var(--f-data);font-size:12.5px;color:var(--ink-2)}
  .doc :global(.entries dd){margin:4px 0 0}
</style>
