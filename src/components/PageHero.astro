---
// The first screen of a marketing page (v2): the title (a line break where the copy has "\n"), what the page is about,
// and what goes under them (the default slot: actions or a notice). With a picture of the product ("vis") the two sit
// side by side; without one the copy runs up to 1000 wide and the page goes on right under it.
interface Props { title: string; lead: string }
const { title, lead } = Astro.props;
const split = Astro.slots.has('vis');
---
<section class:list={['phero', { split }]}>
  <div class="wrap phero-in">
    <div class="phero-copy">
      <h1 class="hero-title">{title.split('\n').map((line, i) => <>{i > 0 && <> <br /></>}{line}</>)}</h1>
      <p class="lead">{lead}</p>
      <slot />
    </div>
    {split && <div class="phero-vis"><slot name="vis" /></div>}
  </div>
</section>
