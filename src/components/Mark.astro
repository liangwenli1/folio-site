---
// The Folio mark: a guilloche rosette in a ring, like the security printing in the page backgrounds. Drawn in the
// current colour (the stamp colour, via .seal), so it follows the dark theme.
const lines = Array.from({ length: 8 }, (_, i) => i * 22.5);
---
<svg class="seal" viewBox="0 0 64 64" fill="none" stroke="currentColor" aria-hidden="true">
  <circle cx="32" cy="32" r="28.5" stroke-width="3.6" />
  {lines.map(a => <ellipse cx="32" cy="32" rx="22" ry="9.5" stroke-width="2" transform={`rotate(${a} 32 32)`} />)}
</svg>
